@using VMS.Web.Services
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Administration Dashboard";

    var canManageDepartments =
        await PermissionService.HasPermissionAsync(
            User,
            "Department.Manage");

    var canManageGroups =
        await PermissionService.HasPermissionAsync(
            User,
            "Group.Manage");

    var canManageUsers =
        await PermissionService.HasPermissionAsync(
            User,
            "User.Manage");
}


<h2 class="mb-4">Administration Dashboard</h2>

<div class="row g-3">

    <div class="col-md-4">
        <a asp-controller="User"
           asp-action="Index"
           class="admin-stat-link">

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-blue">
                    👥
                </div>

                <div>
                    <div class="admin-stat-label">
                        Total Users
                    </div>

                    <div class="admin-stat-value">
                        @ViewBag.TotalUsers
                    </div>

                    <div class="admin-stat-action">
                        View all users →
                    </div>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="User"
           asp-action="Index"
           asp-route-filter="active"
           class="admin-stat-link">

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-green">
                    👤
                </div>

                <div>
                    <div class="admin-stat-label">
                        Active Users
                    </div>

                    <div class="admin-stat-value">
                        @ViewBag.ActiveUsers
                    </div>

                    <div class="admin-stat-action">
                        View active users →
                    </div>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Department"
           asp-action="Index"
           class="admin-stat-link">

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-purple">
                    🏢
                </div>

                <div>
                    <div class="admin-stat-label">
                        Departments
                    </div>

                    <div class="admin-stat-value">
                        @ViewBag.TotalDepartments
                    </div>

                    <div class="admin-stat-action">
                        Manage departments →
                    </div>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Group"
           asp-action="Index"
           class="admin-stat-link">

            <div class="admin-stat-card">
                <div class="admin-stat-icon admin-icon-yellow">
                    👥
                </div>

                <div>
                    <div class="admin-stat-label">
                        Groups
                    </div>

                    <div class="admin-stat-value">
                        @ViewBag.TotalGroups
                    </div>

                    <div class="admin-stat-action">
                        Manage groups →
                    </div>
                </div>
            </div>

        </a>
    </div>

    <div class="col-md-4">
        <div class="admin-stat-card">

            <div class="admin-stat-icon admin-icon-red">
                🛡️
            </div>

            <div>
                <div class="admin-stat-label">
                    Permissions
                </div>

                <div class="admin-stat-value">
                    @ViewBag.TotalPermissions
                </div>

                <div class="admin-stat-action text-muted">
                    System permissions
                </div>
            </div>

        </div>
    </div>

</div>

<hr class="my-4" />

<h4>Administration</h4>

<div class="list-group">

    <div class="admin-management">

        @if (canManageDepartments)
        {
            <a asp-controller="Department"
               asp-action="Index"
               class="admin-management-item">

                <div class="admin-management-left">
                    <div class="admin-management-icon admin-icon-purple">
                        🏢
                    </div>

                    <div>
                        <div class="admin-management-title">
                            Manage Departments
                        </div>

                        <div class="admin-management-description">
                            Add, edit and manage departments
                        </div>
                    </div>
                </div>

                <span class="admin-management-arrow">›</span>

            </a>
        }

        @if (canManageGroups)
        {
            <a asp-controller="Group"
               asp-action="Index"
               class="admin-management-item">

                <div class="admin-management-left">
                    <div class="admin-management-icon admin-icon-yellow">
                        👥
                    </div>

                    <div>
                        <div class="admin-management-title">
                            Manage Groups
                        </div>

                        <div class="admin-management-description">
                            Add, edit and manage groups
                        </div>
                    </div>
                </div>

                <span class="admin-management-arrow">›</span>

            </a>
        }

        @if (canManageUsers)
        {
            <a asp-controller="User"
               asp-action="Index"
               class="admin-management-item">

                <div class="admin-management-left">
                    <div class="admin-management-icon admin-icon-green">
                        👤
                    </div>

                    <div>
                        <div class="admin-management-title">
                            Manage Users
                        </div>

                        <div class="admin-management-description">
                            Create users and manage their access
                        </div>
                    </div>
                </div>

                <span class="admin-management-arrow">›</span>

            </a>
        }

    </div>

</div>