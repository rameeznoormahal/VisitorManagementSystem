@using VMS.Web.Services
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Administration Dashboard";

    var canManageDepartments =
        await PermissionService.HasPermissionAsync(
            User,
            "Department.Manage");

    var canManageGroups =
        await PermissionService.HasPermissionAsync(
            User,
            "Group.Manage");

    var canManageUsers =
        await PermissionService.HasPermissionAsync(
            User,
            "User.Manage");
}


<div class="admin-page">

    <!-- PAGE HEADER -->
    <div class="admin-page-header">

        <div>
            <div class="admin-eyebrow">
                SYSTEM MANAGEMENT
            </div>

            <h2>Administration</h2>

            <p>
                Manage users, organizational structure,
                access groups and system permissions.
            </p>
        </div>

        <div class="admin-security-status">
            <span class="admin-status-dot"></span>

            <div>
                <strong>System Active</strong>
                <small>Administration services available</small>
            </div>
        </div>

    </div>


    <!-- KPI CARDS -->
    <div class="row g-3 mb-4">

        <!-- USERS -->
        <div class="col-6 col-md-4 col-xl">

            <a asp-controller="User"
               asp-action="Index"
               class="admin-stat-link">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon stat-purple">
                        <i class="bi bi-people"></i>
                    </div>

                    <div class="admin-stat-info">

                        <span>Total Users</span>

                        <strong>
                            @ViewBag.TotalUsers
                        </strong>

                    </div>

                    <i class="bi bi-arrow-up-right admin-stat-arrow"></i>

                </div>

            </a>

        </div>


        <!-- ACTIVE USERS -->
        <div class="col-6 col-md-4 col-xl">

            <a asp-controller="User"
               asp-action="Index"
               asp-route-filter="active"
               class="admin-stat-link">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon stat-green">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div class="admin-stat-info">

                        <span>Active Users</span>

                        <strong>
                            @ViewBag.ActiveUsers
                        </strong>

                    </div>

                    <i class="bi bi-arrow-up-right admin-stat-arrow"></i>

                </div>

            </a>

        </div>


        <!-- DEPARTMENTS -->
        <div class="col-6 col-md-4 col-xl">

            <a asp-controller="Department"
               asp-action="Index"
               class="admin-stat-link">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon stat-blue">
                        <i class="bi bi-building"></i>
                    </div>

                    <div class="admin-stat-info">

                        <span>Departments</span>

                        <strong>
                            @ViewBag.TotalDepartments
                        </strong>

                    </div>

                    <i class="bi bi-arrow-up-right admin-stat-arrow"></i>

                </div>

            </a>

        </div>


        <!-- GROUPS -->
        <div class="col-6 col-md-4 col-xl">

            <a asp-controller="Group"
               asp-action="Index"
               class="admin-stat-link">

                <div class="admin-stat-card">

                    <div class="admin-stat-icon stat-yellow">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <div class="admin-stat-info">

                        <span>Groups</span>

                        <strong>
                            @ViewBag.TotalGroups
                        </strong>

                    </div>

                    <i class="bi bi-arrow-up-right admin-stat-arrow"></i>

                </div>

            </a>

        </div>


        <!-- PERMISSIONS -->
        <div class="col-6 col-md-4 col-xl">

            <div class="admin-stat-card">

                <div class="admin-stat-icon stat-coral">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <div class="admin-stat-info">

                    <span>Permissions</span>

                    <strong>
                        @ViewBag.TotalPermissions
                    </strong>

                </div>

            </div>

        </div>

    </div>

    <div class="admin-section-header">
        <div>
            <h4>Management</h4>
            <p>
                Configure core system administration.
            </p>
        </div>
    </div>

    <div class="row g-3">

        @if (canManageDepartments)
        {
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Department"
                   asp-action="Index"
                   class="admin-action-card">

                    <div class="admin-action-icon stat-blue">
                        <i class="bi bi-building"></i>
                    </div>

                    <div class="admin-action-content">
                        <h5>Manage Departments</h5>

                        <p>
                            Add, edit and maintain the organizational
                            department structure.
                        </p>

                        <span>
                            Open departments
                            <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>

                </a>
            </div>
        }


        @if (canManageGroups)
        {
            <div class="col-md-6 col-xl-4">
                <a asp-controller="Group"
                   asp-action="Index"
                   class="admin-action-card">

                    <div class="admin-action-icon stat-yellow">
                        <i class="bi bi-people"></i>
                    </div>

                    <div class="admin-action-content">
                        <h5>Manage Groups</h5>

                        <p>
                            Configure security groups and assign
                            system access permissions.
                        </p>

                        <span>
                            Open groups
                            <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>

                </a>
            </div>
        }


        @if (canManageUsers)
        {
            <div class="col-md-6 col-xl-4">
                <a asp-controller="User"
                   asp-action="Index"
                   class="admin-action-card">

                    <div class="admin-action-icon stat-green">
                        <i class="bi bi-person-gear"></i>
                    </div>

                    <div class="admin-action-content">
                        <h5>Manage Users</h5>

                        <p>
                            Create users, maintain profiles and
                            control account access.
                        </p>

                        <span>
                            Open users
                            <i class="bi bi-arrow-right"></i>
                        </span>
                    </div>

                </a>
            </div>
        }

    </div>



</div>