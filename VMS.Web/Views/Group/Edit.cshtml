@model VMS.Web.ViewModels.Groups.GroupViewModel

@{
    ViewData["Title"] = "Edit Group";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            ACCESS CONTROL
        </div>

        <h2>Edit Group</h2>

        <p>
            Update group information and configure system permissions.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Groups

    </a>

</div>


<div class="premium-form-card">

    <div class="premium-form-card-header">

        <div>
            <h5>Group Information</h5>

            <span>
                Update the group details and permission assignments.
            </span>
        </div>

        <div class="premium-form-header-icon stat-purple">
            <i class="bi bi-people"></i>
        </div>

    </div>


    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="GroupId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger m-3">
        </div>


        <div class="premium-form-body">

            <div class="row g-3">

                <div class="col-md-5">

                    <label asp-for="GroupName"
                           class="premium-form-label">
                        Group Name
                    </label>

                    <input asp-for="GroupName"
                           class="form-control premium-form-control"
                           placeholder="Enter group name" />

                    <span asp-validation-for="GroupName"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-7">

                    <label asp-for="Description"
                           class="premium-form-label">
                        Description
                    </label>

                    <input asp-for="Description"
                           class="form-control premium-form-control"
                           placeholder="Enter group description" />

                    <span asp-validation-for="Description"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>


        <!-- PERMISSIONS -->
        <div class="permission-section">

            <div class="permission-section-header">

                <div>

                    <h5>
                        Permissions
                    </h5>

                    <p>
                        Select the functions users in this group
                        are allowed to access.
                    </p>

                </div>


                <div class="permission-count">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        @Model.Permissions.Count(x => x.IsSelected)
                        selected
                    </span>

                </div>

            </div>


            <div class="permission-toolbar">

                <button type="button"
                        class="permission-toolbar-button"
                        onclick="selectAllPermissions()">

                    <i class="bi bi-check2-square"></i>
                    Select All

                </button>

                <button type="button"
                        class="permission-toolbar-button"
                        onclick="clearAllPermissions()">

                    <i class="bi bi-square"></i>
                    Clear All

                </button>

            </div>


            <div class="permission-grid">

                @for (int i = 0;
                                i < Model.Permissions.Count;
                                i++)
                {
                    <label class="permission-card">

                        <input type="hidden"
                               asp-for="Permissions[i].PermissionId" />

                        <input type="hidden"
                               asp-for="Permissions[i].PermissionCode" />

                        <input type="hidden"
                               asp-for="Permissions[i].PermissionName" />


                        <input asp-for="Permissions[i].IsSelected"
                               class="form-check-input permission-checkbox" />


                        <div class="permission-card-content">

                            <div class="permission-icon">

                                @if (Model.Permissions[i]
                                                            .PermissionCode
                                                            .StartsWith("Visitor."))
                                {
                                    <i class="bi bi-person-badge"></i>
                                }
                                else if (Model.Permissions[i]
                                .PermissionCode
                                .StartsWith("Report."))
                                {
                                    <i class="bi bi-bar-chart"></i>
                                }
                                else if (Model.Permissions[i]
                                .PermissionCode
                                .StartsWith("Department."))
                                {
                                    <i class="bi bi-building"></i>
                                }
                                else if (Model.Permissions[i]
                                .PermissionCode
                                .StartsWith("Group."))
                                {
                                    <i class="bi bi-people"></i>
                                }
                                else if (Model.Permissions[i]
                                .PermissionCode
                                .StartsWith("User."))
                                {
                                    <i class="bi bi-person-gear"></i>
                                }
                                else
                                {
                                    <i class="bi bi-shield-check"></i>
                                }

                            </div>


                            <div>

                                <div class="permission-card-title">
                                    @Model.Permissions[i].PermissionName
                                </div>

                                <div class="permission-code">
                                    @Model.Permissions[i].PermissionCode
                                </div>

                            </div>

                        </div>

                    </label>
                }

            </div>

        </div>


        <div class="premium-form-footer">

            <a asp-action="Index"
               class="btn premium-secondary-button">

                Cancel

            </a>

            <button type="submit"
                    class="btn premium-primary-button">

                <i class="bi bi-check-lg"></i>
                Save Changes

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function selectAllPermissions() {

            document
                .querySelectorAll(
                    '.permission-checkbox')
                .forEach(function (checkbox) {

                    checkbox.checked = true;

                });

            updatePermissionCount();
        }


        function clearAllPermissions() {

            document
                .querySelectorAll(
                    '.permission-checkbox')
                .forEach(function (checkbox) {

                    checkbox.checked = false;

                });

            updatePermissionCount();
        }


        function updatePermissionCount() {

            const selected =
                document.querySelectorAll(
                    '.permission-checkbox:checked')
                .length;

            const label =
                document.querySelector(
                    '.permission-count span');

            if (label) {
                label.textContent =
                    selected + ' selected';
            }
        }


        document
            .querySelectorAll(
                '.permission-checkbox')
            .forEach(function (checkbox) {

                checkbox.addEventListener(
                    'change',
                    updatePermissionCount);

            });

    </script>

}