@model IEnumerable<VMS.Domain.Entities.Group>

@{
    ViewData["Title"] = "Groups";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            ACCESS CONTROL
        </div>

        <h2>Groups</h2>

        <p>
            Manage security groups and permission assignments.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-left"></i>
            Administration

        </a>

        <a asp-action="Create"
           class="btn premium-primary-button">

            <i class="bi bi-plus-lg"></i>
            Add Group

        </a>

    </div>

</div>


<div class="row g-3 mb-3">

    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Total Groups</span>

                <strong>
                    @ViewBag.TotalGroups
                </strong>
            </div>

        </div>
    </div>


    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Active Groups</span>

                <strong>
                    @ViewBag.ActiveGroups
                </strong>
            </div>

        </div>
    </div>


    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-coral">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>
                <span>Inactive Groups</span>

                <strong>
                    @ViewBag.InactiveGroups
                </strong>
            </div>

        </div>
    </div>

</div>
<div class="premium-filter-card mb-3">

    <form asp-action="Index"
          method="get"
          class="department-filter-form">

        <div class="premium-search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by group name..." />

        </div>

        <div class="premium-filter-select">

            <select name="status"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Status
                </option>

                <option value="active"
                        selected="@(ViewBag.Status == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(ViewBag.Status == "inactive")">
                    Inactive
                </option>

            </select>

        </div>

        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-search"></i>
            Search

        </button>

        <a asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-x-lg"></i>
            Clear

        </a>

    </form>

</div>
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Security Groups</h5>

            <span>
                @Model.Count() group(s)
            </span>
        </div>

    </div>

    <div class="table-responsive">

        <table class="table premium-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <div class="group-table-icon stat-purple">
                                        <i class="bi bi-people"></i>
                                    </div>

                                    <strong>
                                        @item.GroupName
                                    </strong>

                                </div>
                            </td>

                            <td class="text-muted">
                                @item.Description
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="premium-status-badge status-active">
                                        <span></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="premium-status-badge status-inactive">
                                        <span></span>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                @if (item.GroupName == "Administrators")
                                {
                                    <span class="protected-badge">

                                        <i class="bi bi-shield-lock"></i>
                                        Protected

                                    </span>
                                }
                                else
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.GroupId"
                                       class="btn table-action-button"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@item.GroupId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn table-action-button table-action-danger"
                                                    title="Deactivate">

                                                <i class="bi bi-slash-circle"></i>

                                            </button>

                                        </form>
                                    }
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="4"
                            class="text-center py-5 text-muted">

                            <i class="bi bi-search fs-4 d-block mb-2"></i>

                            No groups match your search.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>