@using VMS.Web.Services
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Dashboard";

    var canViewVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.View");

    var canEditVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Edit");

    var canValidateQr =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.ValidateQR");

    var canApproveVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Approve");

    var canRejectVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Reject");
}
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h2 class="mb-1">Dashboard</h2>
    <div class="text-muted">
        Visitor management overview
    </div>
</div>
@if (canViewVisitor)
{
    <div class="mb-4">
        <h5 class="mb-3">Visitor Master</h5>

        <div class="row g-3">

            <div class="col-md-4">
                <a asp-controller="Visitor"
                   asp-action="Index"
                   class="kpi-card-link">

                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">

                            <div class="kpi-header">

                                <div>
                                    <div class="dashboard-label">
                                        Total Registered Visitors
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.TotalRegisteredVisitors
                                    </div>
                                </div>

                                <div class="kpi-icon kpi-blue">
                                    <i class="bi bi-people"></i>
                                </div>

                            </div>

                            <div class="kpi-action">
                                View all visitors →
                            </div>

                        </div>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Visitor"
                   asp-action="Index"
                   asp-route-filter="active"
                   class="kpi-card-link">

                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Active Visitors
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.ActiveVisitors
                                    </div>
                                </div>
                                <div class="kpi-icon kpi-green">
                                    <i class="bi bi-person-check"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                View active visitors →
                            </div>
                        </div>
                    </div>

                </a>
            </div>

            <div class="col-md-4">
                <a asp-controller="Visitor"
                   asp-action="Index"
                   asp-route-filter="expired"
                   class="kpi-card-link">

                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Expired IDs
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.ExpiredIdVisitors
                                    </div>
                                </div>

                                <div class="kpi-icon kpi-red">
                                    <i class="bi bi-person-x"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                Review expired IDs →
                            </div>
                        </div>
                    </div>

                </a>
            </div>

        </div>
    </div>
}
@if (canValidateQr)
{
    <div class="mb-4">
        <h5 class="mb-3">Today / Live Operations</h5>

        <div class="row g-3">

            <div class="col-md-4 col-xl-3">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   asp-route-filter="expected"
                   class="kpi-card-link">

                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Expected Today
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.ExpectedToday
                                    </div>
                                </div>

                                <div class="kpi-icon kpi-blue">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                View expected visitors →
                            </div>
                        </div>
                    </div>

                </a>
            </div>

            <div class="col-md-4 col-xl-3">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   asp-route-filter="inside"
                   class="kpi-card-link">

                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Currently Inside
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.CurrentlyInside
                                    </div>
                                </div>
                                <div class="kpi-icon kpi-purple">
                                    <i class="bi bi-box-arrow-right"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                View Currently Inside →
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4 col-xl-3">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   asp-route-filter="checkedout"
                   class="kpi-card-link">
                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Checked Out Today
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.CheckedOutToday
                                    </div>
                                </div>
                                <div class="kpi-icon kpi-orange">
                                    <i class="bi bi-clock-history"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                View Checked Out Today →
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-md-4 col-xl-3">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   class="kpi-card-link">
                    <div class="card dashboard-card kpi-card">
                        <div class="card-body">
                            <div class="kpi-header">
                                <div>
                                    <div class="dashboard-label">
                                        Not Yet Arrived
                                    </div>

                                    <div class="dashboard-value">
                                        @ViewBag.NotYetArrived
                                    </div>
                                </div>
                                <div class="kpi-icon kpi-yellow">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                            </div>
                            <div class="kpi-action">
                                View Not Yet Arrived →
                            </div>
                        </div>
                    </div>
                </a>
            </div>
            @if (canApproveVisitor || canRejectVisitor)
            {
                <div class="col-md-4 col-xl-3">
                    <a asp-controller="Reception"
                       asp-action="Visitors"
                       asp-route-filter="inside"
                       class="kpi-card-link">
                        <div class="card dashboard-card kpi-card">
                            <div class="card-body">
                                <div class="kpi-header">
                                    <div>
                                        <div class="dashboard-label">
                                            Pending Approvals
                                        </div>

                                        <div class="dashboard-value">
                                            @ViewBag.PendingApprovals
                                        </div>
                                    </div>
                                    <div class="kpi-icon kpi-yellow">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                </div>
                                <div class="kpi-action">
                                    View Pending Approvals →
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }

        </div>
    </div>
}