@using VMS.Web.Services
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Dashboard";

    var canViewVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.View");

    var canEditVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Edit");

    var canValidateQr =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.ValidateQR");

    var canApproveVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Approve");

    var canRejectVisitor =
        await PermissionService.HasPermissionAsync(
            User, "Visitor.Reject");
}
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page-header mb-3">
    <div>
        <h2 class="dashboard-title">Dashboard</h2>
        <div class="dashboard-subtitle">
            Overview of today's visitor activities and system status.
        </div>
    </div>

    <div class="dashboard-date">
        <i class="bi bi-calendar3"></i>
        @DateTime.Today.ToString("dd MMM yyyy")
    </div>
</div>


@if (canViewVisitor)
{
    <div class="row g-3 mb-3">

        <!-- TOTAL VISITORS -->
        <div class="col-6 col-md-4 col-xl">
            <a asp-controller="Visitor"
               asp-action="Index"
               class="kpi-card-link">

                <div class="premium-kpi-card">

                    <div class="premium-kpi-icon kpi-purple">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <div class="premium-kpi-label">
                            Total Registered Visitors
                        </div>

                        <div class="premium-kpi-value">
                            @ViewBag.TotalRegisteredVisitors
                        </div>
                    </div>

                </div>

            </a>
        </div>


        <!-- ACTIVE -->
        <div class="col-6 col-md-4 col-xl">
            <a asp-controller="Visitor"
               asp-action="Index"
               asp-route-filter="active"
               class="kpi-card-link">

                <div class="premium-kpi-card">

                    <div class="premium-kpi-icon kpi-green">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <div>
                        <div class="premium-kpi-label">
                            Active Visitors
                        </div>

                        <div class="premium-kpi-value">
                            @ViewBag.ActiveVisitors
                        </div>
                    </div>

                </div>

            </a>
        </div>


        <!-- EXPIRED -->
        <div class="col-6 col-md-4 col-xl">
            <a asp-controller="Visitor"
               asp-action="Index"
               asp-route-filter="expired"
               class="kpi-card-link">

                <div class="premium-kpi-card">

                    <div class="premium-kpi-icon kpi-red">
                        <i class="bi bi-person-x"></i>
                    </div>

                    <div>
                        <div class="premium-kpi-label">
                            Expired IDs
                        </div>

                        <div class="premium-kpi-value">
                            @ViewBag.ExpiredIdVisitors
                        </div>
                    </div>

                </div>

            </a>
        </div>


        @if (canValidateQr)
        {
            <!-- EXPECTED -->
            <div class="col-6 col-md-4 col-xl">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   asp-route-filter="expected"
                   class="kpi-card-link">

                    <div class="premium-kpi-card">

                        <div class="premium-kpi-icon kpi-blue">
                            <i class="bi bi-calendar2-check"></i>
                        </div>

                        <div>
                            <div class="premium-kpi-label">
                                Expected Today
                            </div>

                            <div class="premium-kpi-value">
                                @ViewBag.ExpectedToday
                            </div>
                        </div>

                    </div>

                </a>
            </div>


            <!-- CURRENTLY INSIDE -->
            <div class="col-6 col-md-4 col-xl">
                <a asp-controller="Reception"
                   asp-action="Visitors"
                   asp-route-filter="inside"
                   class="kpi-card-link">

                    <div class="premium-kpi-card">

                        <div class="premium-kpi-icon kpi-purple">
                            <i class="bi bi-box-arrow-in-right"></i>
                        </div>

                        <div>
                            <div class="premium-kpi-label">
                                Currently Inside
                            </div>

                            <div class="premium-kpi-value">
                                @ViewBag.CurrentlyInside
                            </div>
                        </div>

                    </div>

                </a>
            </div>
        }

    </div>
}


@if (canValidateQr)
{
    <div class="row g-3 mb-4">

        <!-- CHECKED OUT -->
        <div class="col-6 col-md-4 col-xl-3">

            <a asp-controller="Reception"
               asp-action="Visitors"
               asp-route-filter="checkedout"
               class="kpi-card-link">

                <div class="premium-kpi-card">

                    <div class="premium-kpi-icon kpi-orange">
                        <i class="bi bi-clock-history"></i>
                    </div>

                    <div>
                        <div class="premium-kpi-label">
                            Checked Out Today
                        </div>

                        <div class="premium-kpi-value">
                            @ViewBag.CheckedOutToday
                        </div>
                    </div>

                </div>

            </a>

        </div>


        <!-- NOT ARRIVED -->
        <div class="col-6 col-md-4 col-xl-3">

            <a asp-controller="Reception"
               asp-action="Visitors"
               class="kpi-card-link">

                <div class="premium-kpi-card">

                    <div class="premium-kpi-icon kpi-yellow">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>
                        <div class="premium-kpi-label">
                            Not Yet Arrived
                        </div>

                        <div class="premium-kpi-value">
                            @ViewBag.NotYetArrived
                        </div>
                    </div>

                </div>

            </a>

        </div>


        @if (canApproveVisitor || canRejectVisitor)
        {
            <!-- PENDING APPROVALS -->
            <div class="col-6 col-md-4 col-xl-3">

                <a asp-controller="Approval"
                   asp-action="Index"
                   class="kpi-card-link">

                    <div class="premium-kpi-card">

                        <div class="premium-kpi-icon kpi-coral">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <div class="premium-kpi-label">
                                Pending Approvals
                            </div>

                            <div class="premium-kpi-value">
                                @ViewBag.PendingApprovals
                            </div>
                        </div>

                    </div>

                </a>

            </div>
        }

    </div>
}
<div class="row g-3 mb-4">

    <!-- VISITOR TREND -->
    <div class="col-xl-6">

        <div class="premium-chart-card">

            <div class="premium-chart-header">

                <div>
                    <h5>Visitor Trend</h5>
                    <span>Scheduled visitors during the last 7 days</span>
                </div>

                <div class="premium-chart-icon kpi-purple">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>

            </div>

            <div class="premium-chart-body">
                <canvas id="visitorTrendChart"></canvas>
            </div>

        </div>

    </div>


    <!-- DEPARTMENT BAR CHART -->
    <div class="col-xl-6">

        <div class="premium-chart-card">

            <div class="premium-chart-header">

                <div>
                    <h5>Visits by Department</h5>
                    <span>Top departments by visit request volume</span>
                </div>

                <div class="premium-chart-icon kpi-blue">
                    <i class="bi bi-bar-chart"></i>
                </div>

            </div>

            <div class="premium-chart-body">
                <canvas id="departmentChart"></canvas>
            </div>

        </div>

    </div>

</div>


<div class="row g-3 mb-4">

    <!-- VISITOR DISTRIBUTION -->
    <div class="col-xl-4">

        <div class="premium-chart-card">

            <div class="premium-chart-header">

                <div>
                    <h5>Visitor Distribution</h5>
                    <span>Visitors grouped by identification type</span>
                </div>

                <div class="premium-chart-icon kpi-coral">
                    <i class="bi bi-pie-chart"></i>
                </div>

            </div>

            <div class="premium-chart-body premium-chart-body-small">
                <canvas id="visitorDistributionChart"></canvas>
            </div>

        </div>

    </div>


    <!-- REAL-TIME STATUS -->
    <div class="col-xl-8">

        <div class="premium-status-card">

            <div class="premium-chart-header">

                <div>
                    <h5>Real-Time Visitor Status</h5>
                    <span>Current operational position</span>
                </div>

                <span class="live-status-badge">
                    <span class="live-dot"></span>
                    LIVE
                </span>

            </div>


            <div class="status-grid">

                <div class="status-item">
                    <div class="status-number status-purple">
                        @ViewBag.ExpectedToday
                    </div>

                    <div class="status-label">
                        Expected Today
                    </div>
                </div>


                <div class="status-item">
                    <div class="status-number status-green">
                        @ViewBag.CurrentlyInside
                    </div>

                    <div class="status-label">
                        Currently Inside
                    </div>
                </div>


                <div class="status-item">
                    <div class="status-number status-orange">
                        @ViewBag.CheckedOutToday
                    </div>

                    <div class="status-label">
                        Checked Out
                    </div>
                </div>


                <div class="status-item">
                    <div class="status-number status-red">
                        @ViewBag.NotYetArrived
                    </div>

                    <div class="status-label">
                        Not Arrived
                    </div>
                </div>


                <div class="status-item">
                    <div class="status-number status-blue">
                        @ViewBag.PendingApprovals
                    </div>

                    <div class="status-label">
                        Pending Approval
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        Chart.defaults.font.family =
            "'Aptos', 'Segoe UI', sans-serif";

        Chart.defaults.color =
            "#7a7480";


        // ==========================================
        // VISITOR TREND
        // ==========================================

        const visitorTrendLabels =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.VisitorTrendLabels));

    const visitorTrendValues =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.VisitorTrendValues));


    new Chart(
        document.getElementById(
            "visitorTrendChart"),
        {
            type: "line",

            data: {
                labels: visitorTrendLabels,

                datasets: [{
                    label: "Visitors",

                    data:
                        visitorTrendValues,

                    borderColor:
                        "#6500ae",

                    backgroundColor:
                        "rgba(101, 0, 174, 0.08)",

                    fill: true,

                    borderWidth: 2,

                    tension: 0.4,

                    pointRadius: 3,

                    pointBackgroundColor:
                        "#6500ae"
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(0,0,0,0.04)"
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });


    // ==========================================
    // DEPARTMENT BAR CHART
    // ==========================================

    const departmentLabels =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.DepartmentLabels));

    const departmentValues =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.DepartmentValues));


    new Chart(
        document.getElementById(
            "departmentChart"),
        {
            type: "bar",

            data: {
                labels:
                    departmentLabels,

                datasets: [{
                    data:
                        departmentValues,

                    backgroundColor:
                        "#7651d6",

                    borderRadius: 7,

                    borderSkipped: false
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,

                        ticks: {
                            precision: 0
                        },

                        grid: {
                            color:
                                "rgba(0,0,0,0.04)"
                        }
                    },

                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });


    // ==========================================
    // VISITOR TYPE DOUGHNUT
    // ==========================================

    const visitorTypeLabels =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.VisitorTypeLabels));

    const visitorTypeValues =
        @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.VisitorTypeValues));


    new Chart(
        document.getElementById(
            "visitorDistributionChart"),
        {
            type: "doughnut",

            data: {
                labels:
                    visitorTypeLabels,

                datasets: [{
                    data:
                        visitorTypeValues,

                    backgroundColor: [
                        "#6500ae",
                        "#ff5b6e",
                        "#3867f4",
                        "#15955c",
                        "#f26a32"
                    ],

                    borderWidth: 0,

                    hoverOffset: 5
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                cutout: "70%",

                plugins: {
                    legend: {
                        position: "bottom",

                        labels: {
                            usePointStyle: true,
                            boxWidth: 7,
                            padding: 15,

                            font: {
                                size: 10
                            }
                        }
                    }
                }
            }
        });

</script>
}