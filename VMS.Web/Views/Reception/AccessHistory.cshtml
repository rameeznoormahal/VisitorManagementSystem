@model IEnumerable<VMS.Web.ViewModels.Reception.AccessHistoryViewModel>

@{
    ViewData["Title"] = "Access History";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            RECEPTION
        </div>

        <h2>Visitor Access History</h2>

        <p>
            Complete visitor entry and exit movement history.
        </p>
    </div>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Dashboard

    </a>

</div>


<div class="premium-table-card">

    <!-- HEADER -->
    <div class="premium-table-header">

        <div>
            <h5>Access Movement Log</h5>

            <span>
                @Model.Count() access record(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-clock-history"></i>
        </div>

    </div>
    <div class="premium-filter-card mb-3">

        <form asp-action="AccessHistory"
              method="get"
              class="access-history-filter-form">

            <!-- SEARCH -->
            <div class="premium-search-box access-history-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search visitor, ID or visit reference..." />

            </div>


            <!-- FROM -->
            <div class="access-filter-field">

                <label>
                    From
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-control" />

            </div>


            <!-- TO -->
            <div class="access-filter-field">

                <label>
                    To
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-control" />

            </div>


            <!-- STATUS -->
            <div class="premium-filter-select">

                <select name="status"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">
                        All Status
                    </option>

                    <option value="inside"
                            selected="@(ViewBag.Status == "inside")">
                        Currently Inside
                    </option>

                    <option value="completed"
                            selected="@(ViewBag.Status == "completed")">
                        Completed
                    </option>

                </select>

            </div>


            <!-- FILTER -->
            <button type="submit"
                    class="btn premium-primary-button">

                <i class="bi bi-funnel"></i>
                Filter

            </button>


            <!-- CLEAR -->
            <a asp-action="AccessHistory"
               class="btn premium-secondary-button">

                <i class="bi bi-x-lg"></i>
                Clear

            </a>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table premium-table access-history-table align-middle mb-0">

            <thead>

                <tr>
                    <th>Visit</th>
                    <th>Visitor</th>
                    <th>Identity</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Processed By</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>

            </thead>


            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var duration =
                        (item.ExitTime ?? DateTime.Now) -
                        item.EntryTime;

                        <tr class="@(item.ExitTime == null
                                                                     ? "access-history-active-row"
                                                                     : "")">


                    <!-- VISIT -->
                    <td>

                                <div class="history-reference">

                                    <span>
                                        VISIT REFERENCE
                                    </span>

                                    <strong>
                                        @item.VisitReference
                                    </strong>

                                </div>

                            </td>


                            <!-- VISITOR -->
                            <td>

                                <div class="history-visitor">

                                    <div class="history-visitor-avatar">

                                        <i class="bi bi-person"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            @item.VisitorName
                                        </strong>

                                        <span>
                                            Visitor
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- IDENTITY -->
                            <td>

                                <div class="history-id">

                                    <i class="bi bi-person-vcard"></i>

                                    <span>
                                        @item.IdNumber
                                    </span>

                                </div>

                            </td>


                            <!-- CHECK IN -->
                            <td>

                                <div class="history-time">

                                    <span class="history-time-icon history-entry">

                                        <i class="bi bi-box-arrow-in-right"></i>

                                    </span>

                                    <div>

                                        <strong>
                                            @item.EntryTime.ToString("hh:mm tt")
                                        </strong>

                                        <span>
                                            @item.EntryTime.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- CHECK OUT -->
                            <td>

                        @if (item.ExitTime.HasValue)
                                {
                                    <div class="history-time">

                                        <span class="history-time-icon history-exit">

                                            <i class="bi bi-box-arrow-right"></i>

                                        </span>

                                        <div>

                                            <strong>
                                                @item.ExitTime.Value.ToString("hh:mm tt")
                                            </strong>

                                            <span>
                                                @item.ExitTime.Value.ToString("dd MMM yyyy")
                                            </span>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <span class="history-not-completed">

                                        <i class="bi bi-dash-circle"></i>
                                        Not checked out

                                    </span>
                                }

                            </td>


                            <!-- PROCESSED BY -->
                            <td>

                                <div class="history-processed">

                                    <div>

                                        <span>
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            Entry
                                        </span>

                                        <strong>
                                            @item.EntryProcessedBy
                                        </strong>

                                    </div>


                                    <div>

                                        <span>
                                            <i class="bi bi-box-arrow-right"></i>
                                            Exit
                                        </span>

                                        <strong>
                                            @(item.ExitProcessedBy ?? "-")
                                        </strong>

                                    </div>

                                </div>

                            </td>


                            <!-- DURATION -->
                            <td>

                                @if (item.ExitTime.HasValue)
                                {
                                    <span class="history-duration">

                                        <i class="bi bi-stopwatch"></i>

                                        @if (duration.TotalDays >= 1)
                                        {
                                            <text>
                                                @((int)duration.TotalDays)d
                                                @duration.Hours.ToString("00")h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                @((int)duration.TotalHours)h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }

                                    </span>
                                }
                                else
                                {
                                    <span class="history-duration history-duration-active">

                                        <i class="bi bi-stopwatch"></i>

                                        @if (duration.TotalDays >= 1)
                                        {
                                            <text>
                                                @((int)duration.TotalDays)d
                                                @duration.Hours.ToString("00")h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                @((int)duration.TotalHours)h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }

                                    </span>
                                }

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.ExitTime == null)
                                {
                                    <span class="reception-status status-inside">

                                        <i class="bi bi-circle-fill"></i>
                                        Inside

                                    </span>
                                }
                                else
                                {
                                    <span class="reception-status status-completed">

                                        <i class="bi bi-check-circle"></i>
                                        Completed

                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-clock-history"></i>

                                <strong>
                                    No access history found
                                </strong>

                                <span>
                                    Visitor check-in and check-out records will appear here.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>