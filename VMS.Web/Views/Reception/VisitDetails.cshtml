@model VMS.Web.ViewModels.Reception.ReceptionVisitViewModel

@{
    ViewData["Title"] = "Visitor Access";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            RECEPTION
        </div>

        <h2>Visitor Access</h2>

        <p>
            Verify visit authorization and manage visitor check-in and check-out.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-qr-code-scan"></i>
        Scan Another QR

    </a>

</div>


<!-- ACCESS STATUS -->
<div class="@(Model.IsWithinValidPeriod
                     ? "reception-access-banner access-valid"
                     : "reception-access-banner access-invalid") mb-3">

    <div class="reception-access-banner-left">

        <div class="reception-access-banner-icon">

            @if (Model.IsWithinValidPeriod)
            {
                <i class="bi bi-shield-check"></i>
            }
            else
            {
                <i class="bi bi-shield-x"></i>
            }

        </div>

        <div>

            @if (Model.IsWithinValidPeriod)
            {
                <span>ACCESS AUTHORIZED</span>

                <strong>
                    Visit is within the approved access period
                </strong>
            }
            else
            {
                <span>ACCESS CLOSED</span>

                <strong>
                    Visit is outside the approved access period
                </strong>
            }

        </div>

    </div>


    <div class="reception-access-reference">

        <span>VISIT REFERENCE</span>

        <strong>
            @Model.VisitReference
        </strong>

    </div>

</div>


<!-- VISIT INFORMATION -->
<div class="premium-profile-card mb-3">

    <div class="premium-profile-header">

        <div>
            <h5>Visit Information</h5>

            <span>
                Approved visit request and access details
            </span>
        </div>

        <div class="premium-form-header-icon stat-purple">
            <i class="bi bi-calendar2-check"></i>
        </div>

    </div>


    <div class="reception-visit-grid">

        <div class="reception-visit-info">

            <div class="reception-visit-info-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div>
                <span>Host</span>
                <strong>@Model.HostName</strong>
            </div>

        </div>


        <div class="reception-visit-info">

            <div class="reception-visit-info-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <span>Department</span>
                <strong>@Model.DepartmentName</strong>
            </div>

        </div>


        <div class="reception-visit-info">

            <div class="reception-visit-info-icon">
                <i class="bi bi-geo-alt"></i>
            </div>

            <div>
                <span>Meeting Location</span>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.MeetingLocation)
                                        ? "-"
                                        : Model.MeetingLocation)
                </strong>
            </div>

        </div>


        <div class="reception-visit-info">

            <div class="reception-visit-info-icon reception-valid-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <span>Valid From</span>

                <strong>
                    @Model.VisitFromDateTime.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                </strong>
            </div>

        </div>


        <div class="reception-visit-info">

            <div class="reception-visit-info-icon reception-expiry-icon">
                <i class="bi bi-calendar-x"></i>
            </div>

            <div>
                <span>Valid To</span>

                <strong>
                    @Model.VisitToDateTime.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                </strong>
            </div>

        </div>

    </div>


    <!-- PURPOSE -->
    <div class="reception-purpose-box">

        <div class="reception-purpose-icon">
            <i class="bi bi-card-text"></i>
        </div>

        <div>
            <span>PURPOSE OF VISIT</span>

            <strong>
                @Model.Purpose
            </strong>
        </div>

    </div>

</div>


<!-- VISITOR ACCESS LIST -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Visitors</h5>

            <span>
                @Model.Visitors.Count visitor(s) registered for this visit
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-people"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table reception-access-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visitor</th>
                    <th>Identity</th>
                    <th>Company</th>
                    <th>Designation</th>
                    <th>Last Check-In</th>
                    <th>Last Check-Out</th>
                    <th>Status</th>
                    <th class="text-end">Access Action</th>
                </tr>
            </thead>


            <tbody>

                @foreach (var visitor in Model.Visitors)
                {
                    <tr class="@(visitor.IsCurrentlyInside
                                                             ? "visitor-currently-inside"
                                                             : "")">

                        <!-- VISITOR -->
                        <td>

                            <div class="reception-access-profile">

                                <div class="reception-access-avatar">
                                    <i class="bi bi-person"></i>
                                </div>

                                <div>
                                    <strong>
                                        @visitor.FullName
                                    </strong>

                                    <span>
                                        Registered Visitor
                                    </span>
                                </div>

                            </div>

                        </td>


                        <!-- ID -->
                        <td>

                            <div class="reception-access-id">

                                <i class="bi bi-person-vcard"></i>

                                <span>
                                    @visitor.IdNumber
                                </span>

                            </div>

                        </td>


                        <!-- COMPANY -->
                        <td>

                            <div class="reception-access-company">

                                <i class="bi bi-building"></i>

                                <span>
                                    @(string.IsNullOrWhiteSpace(visitor.CompanyName)
                                                                    ? "-"
                                                                    : visitor.CompanyName)
                                                                                      </span>

                            </div>

                        </td>


                        <!-- DESIGNATION -->
                        <td>

                            @(string.IsNullOrWhiteSpace(visitor.Designation)
                                                    ? "-"
                                                    : visitor.Designation)

                    </td>


                        <!-- CHECK IN -->
                        <td>

                        @if (visitor.LastCheckInTime.HasValue)
                            {
                                <div class="reception-time-display">

                                    <span class="time-icon time-checkin">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                    </span>

                                    <div>

                                        <strong>
                                            @visitor.LastCheckInTime.Value
                                            .ToString("hh:mm tt")
                                        </strong>

                                        <span>
                                            @visitor.LastCheckInTime.Value
                                            .ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <span class="reception-no-time">
                                    Not checked in
                                </span>
                            }

                        </td>


                        <!-- CHECK OUT -->
                        <td>

                            @if (visitor.LastCheckOutTime.HasValue)
                            {
                                <div class="reception-time-display">

                                    <span class="time-icon time-checkout">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </span>

                                    <div>

                                        <strong>
                                            @visitor.LastCheckOutTime.Value
                                            .ToString("hh:mm tt")
                                        </strong>

                                        <span>
                                            @visitor.LastCheckOutTime.Value
                                            .ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>
                            }
                            else
                            {
                                <span class="reception-no-time">
                                    -
                                </span>
                            }

                        </td>


                        <!-- STATUS -->
                        <td>

                            @if (visitor.IsCurrentlyInside)
                            {
                                <span class="reception-status status-inside">

                                    <i class="bi bi-circle-fill"></i>
                                    Inside

                                </span>
                            }
                            else
                            {
                                <span class="reception-status status-outside">

                                    <i class="bi bi-circle"></i>
                                    Outside

                                </span>
                            }

                        </td>


                        <!-- ACTION -->
                        <td class="text-end">

                            @if (!Model.IsWithinValidPeriod)
                            {
                                <button type="button"
                                        class="btn reception-access-closed-button"
                                        disabled>

                                    <i class="bi bi-lock"></i>
                                    Access Closed

                                </button>
                            }
                            else if (visitor.IsCurrentlyInside)
                            {
                                <form asp-controller="Reception"
                                      asp-action="CheckOut"
                                      method="post"
                                      class="d-inline reception-access-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="visitRequestId"
                                           value="@Model.VisitRequestId" />

                                    <input type="hidden"
                                           name="visitVisitorId"
                                           value="@visitor.VisitVisitorId" />

                                    <button type="submit"
                                            class="btn reception-checkout-button">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Check Out

                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-controller="Reception"
                                      asp-action="CheckIn"
                                      method="post"
                                      class="d-inline reception-access-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="visitRequestId"
                                           value="@Model.VisitRequestId" />

                                    <input type="hidden"
                                           name="visitVisitorId"
                                           value="@visitor.VisitVisitorId" />

                                    <button type="submit"
                                            class="btn reception-checkin-button">

                                        <i class="bi bi-box-arrow-in-right"></i>
                                        Check In

                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<div class="mt-3">

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-qr-code-scan"></i>
        Scan Another QR

    </a>

</div>