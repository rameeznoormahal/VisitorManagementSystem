@model VMS.Web.ViewModels.Reports.AccessReportViewModel

@{
    ViewData["Title"] = "Access Report";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Access Report</h2>

        <p>
            Analyze visitor check-in, check-out and access duration activity.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>


<!-- FILTERS -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="Access"
          class="access-report-filter-form">

        <div class="access-filter-field">

            <label>
                From Date
            </label>

            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <div class="access-filter-field">

            <label>
                To Date
            </label>

            <input type="date"
                   name="toDate"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <div class="premium-filter-select">

            <label class="report-filter-label">
                Status
            </label>

            <select name="status"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Status
                </option>

                <option value="inside"
                        selected="@(Model.Status == "inside")">
                    Currently Inside
                </option>

                <option value="completed"
                        selected="@(Model.Status == "completed")">
                    Completed
                </option>

            </select>

        </div>


        <div class="premium-search-box access-report-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search visitor, ID, company or visit reference..." />

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-funnel"></i>
            Apply

        </button>


        <a asp-action="Access"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-counterclockwise"></i>
            Reset

        </a>

    </form>

</div>

<div class="row g-3 mb-3">

    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-blue">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <span>Access Sessions</span>

                <strong>
                    @Model.Items.Count
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-building-check"></i>
            </div>

            <div>
                <span>Currently Inside</span>

                <strong>
                    @Model.Items.Count(x => x.IsCurrentlyInside)
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Completed Sessions</span>

                <strong>
                    @Model.Items.Count(x => !x.IsCurrentlyInside)
                </strong>
            </div>

        </div>

    </div>

</div>
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Access Results</h5>

            <span>
                @Model.Items.Count record(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-door-open"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table access-report-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visitor</th>
                    <th>Identity</th>
                    <th>Visit</th>
                    <th>Department</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="@(item.IsCurrentlyInside? "access-report-active-row": "")">

                            <!-- VISITOR -->
                            <td>

                                <a asp-controller="Visitor"
                                   asp-action="Details"
                                   asp-route-id="@item.VisitorId"
                                   class="report-visitor-profile">

                                    <div class="report-visitor-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.VisitorName
                                        </strong>

                                        <span>
                                            @(string.IsNullOrWhiteSpace(item.CompanyName)
                                                                                ? "Visitor"
                                                                                : item.CompanyName)
                                                                                               </span>
                                                                                           </div>

                                </a>

                            </td>


                            <!-- ID -->
                            <td>

                                <div class="report-id">

                                    <i class="bi bi-person-vcard"></i>

                                    <span>
                                        @item.IdNumber
                                    </span>

                                </div>

                            </td>


                            <!-- VISIT -->
                            <td>

                                <div class="report-reference">

                                    <span>
                                        VISIT REFERENCE
                                    </span>

                                    <strong>
                                        @item.VisitReference
                                    </strong>

                                </div>

                            </td>


                            <!-- DEPARTMENT -->
                            <td>

                                <div class="report-department">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(item.DepartmentName)
                                                                        ? "-"
                                                                        : item.DepartmentName)
                            </span>

                                </div>

                            </td>


                            <!-- CHECK IN -->
                            <td>

                                <div class="report-time">

                                    <span class="report-time-icon report-entry">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                    </span>

                                    <div>

                                        <strong>
                                            @item.EntryTime.ToString("hh:mm tt")
                                        </strong>

                                        <span>
                                            @item.EntryTime.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- CHECK OUT -->
                            <td>

                        @if (item.ExitTime.HasValue)
                                {
                                    <div class="report-time">

                                        <span class="report-time-icon report-exit">
                                            <i class="bi bi-box-arrow-right"></i>
                                        </span>

                                        <div>

                                            <strong>
                                                @item.ExitTime.Value.ToString("hh:mm tt")
                                            </strong>

                                            <span>
                                                @item.ExitTime.Value.ToString("dd MMM yyyy")
                                            </span>

                                        </div>

                                    </div>
                                }
                                else
                                {
                                    <span class="report-ongoing">
                                        <i class="bi bi-clock"></i>
                                        Ongoing
                                    </span>
                                }

                            </td>


                            <!-- DURATION -->
                            <td>

                                @if (item.Duration.HasValue)
                                {
                                    var duration =
                                    item.Duration.Value;

                                    <span class="report-duration">

                                        <i class="bi bi-stopwatch"></i>

                                        @if (duration.TotalDays >= 1)
                                        {
                                            <text>
                                                @((int)duration.TotalDays)d
                                                @duration.Hours.ToString("00")h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                @((int)duration.TotalHours)h
                                                @duration.Minutes.ToString("00")m
                                            </text>
                                        }

                                    </span>
                                }
                                else
                                {
                                    <span class="report-duration report-duration-active">
                                        <i class="bi bi-stopwatch"></i>
                                        Ongoing
                                    </span>
                                }

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (item.IsCurrentlyInside)
                                {
                                    <span class="reception-status status-inside">

                                        <i class="bi bi-circle-fill"></i>
                                        Inside

                                    </span>
                                }
                                else
                                {
                                    <span class="reception-status status-completed">

                                        <i class="bi bi-check-circle"></i>
                                        Completed

                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-inbox"></i>

                                <strong>
                                    No access records found
                                </strong>

                                <span>
                                    Try adjusting the report filters.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
