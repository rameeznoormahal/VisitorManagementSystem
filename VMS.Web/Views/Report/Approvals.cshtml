@model VMS.Web.ViewModels.Reports.ApprovalReportViewModel

@{
    ViewData["Title"] = "Approval Report";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Approval Report</h2>
        <div class="text-muted">
            Review pending, approved and rejected visit decisions
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Reports
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Report Filters</strong>
    </div>

    <div class="card-body">

        <form method="get"
              asp-action="Approvals">

            <div class="row g-3">

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">From Date</label>

                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">To Date</label>

                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">Status</label>

                    <select name="status"
                            class="form-select">

                        <option value="">All</option>

                        <option value="pending"
                                selected="@(Model.Status == "pending")">
                            Pending
                        </option>

                        <option value="approved"
                                selected="@(Model.Status == "approved")">
                            Approved
                        </option>

                        <option value="rejected"
                                selected="@(Model.Status == "rejected")">
                            Rejected
                        </option>

                    </select>
                </div>

                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Search</label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Visit reference or purpose..." />
                </div>

            </div>

            <div class="d-flex gap-2 mt-3">

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>
                    Apply Filters
                </button>

                <a asp-action="Approvals"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset
                </a>

            </div>

        </form>

    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Pending
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                            x.Status == "PendingApproval")
                        </div>
                    </div>

                    <div class="kpi-icon kpi-yellow">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Approved
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                                                        x.Status == "Approved" ||
                                                        x.Status == "ReadyForVisit")
                        </div>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Rejected
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                                                        x.Status == "Rejected")
                        </div>
                    </div>

                    <div class="kpi-icon kpi-red">
                        <i class="bi bi-x-circle"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Approval Results</strong>

        <span class="text-muted small">
            @Model.Items.Count record(s)
        </span>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Host</th>
                        <th>Department</th>
                        <th>Visitors</th>
                        <th>Visit Period</th>
                        <th>Status</th>
                        <th>Decision By</th>
                        <th>Decision Date</th>
                        <th>Comments</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.VisitReference
                                    </strong>
                                </td>

                                <td>@item.HostName</td>

                                <td>@item.DepartmentName</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.VisitorCount
                                    </span>
                                </td>

                                <td>
                                    <div>
                                        @(item.VisitFromDateTime.ToString(
                                                                        "dd-MMM-yyyy hh:mm tt"))
                                                                                            </div>

                                    <div class="text-muted small">
                                        to
                                        @(item.VisitToDateTime.ToString(
                                                                        "dd-MMM-yyyy hh:mm tt"))
                            </div>
                        </td>

                                <td>
                            @switch (item.Status)
                                    {
                                        case "PendingApproval":
                                            <span class="badge bg-warning text-dark">
                                                Pending Approval
                                            </span>
                                            break;

                                        case "Approved":
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                            break;

                                        case "ReadyForVisit":
                                            <span class="badge bg-success">
                                                Ready For Visit
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-light text-dark">
                                                @item.Status
                                            </span>
                                            break;
                                    }
                        </td>

                        <td>
                            @(item.DecisionBy ?? "-")
                        </td>

                        <td>
                            @(item.DecisionDate?.ToString(
                                                        "dd-MMM-yyyy hh:mm tt") ?? "-")
                        </td>

                                <td>
                            @if (!string.IsNullOrWhiteSpace(
                                                        item.DecisionComments))
                                    {
                                        <span>
                                            @item.DecisionComments
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                No approval records found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>