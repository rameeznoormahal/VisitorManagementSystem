@model VMS.Web.ViewModels.Reports.ApprovalReportViewModel

@{
    ViewData["Title"] = "Approval Report";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Approval Report</h2>

        <p>
            Review pending, approved and rejected visit decisions.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>


<!-- FILTERS -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="Approvals"
          class="approval-report-filter-form">

        <div class="access-filter-field">

            <label>From Date</label>

            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <div class="access-filter-field">

            <label>To Date</label>

            <input type="date"
                   name="toDate"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <div class="premium-filter-select">

            <label class="report-filter-label">
                Status
            </label>

            <select name="status"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Status
                </option>

                <option value="pending"
                        selected="@(Model.Status == "pending")">
                    Pending
                </option>

                <option value="approved"
                        selected="@(Model.Status == "approved")">
                    Approved
                </option>

                <option value="rejected"
                        selected="@(Model.Status == "rejected")">
                    Rejected
                </option>

            </select>

        </div>


        <div class="premium-search-box approval-report-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search visit reference or purpose..." />

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-funnel"></i>
            Apply

        </button>


        <a asp-action="Approvals"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-counterclockwise"></i>
            Reset

        </a>

    </form>

</div>


<!-- KPI -->
<div class="row g-3 mb-3">

    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-yellow">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>
                <span>Pending</span>

                <strong>
                    @Model.Items.Count(x =>
                    x.Status == "PendingApproval")
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Approved</span>

                <strong>
                    @Model.Items.Count(x =>
                                        x.Status == "Approved" ||
                                        x.Status == "ReadyForVisit")
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-red">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>
                <span>Rejected</span>

                <strong>
                    @Model.Items.Count(x =>
                                        x.Status == "Rejected")
                </strong>
            </div>

        </div>

    </div>

</div>


<!-- RESULTS -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Approval Decisions</h5>

            <span>
                @Model.Items.Count record(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-shield-check"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table approval-report-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visit</th>
                    <th>Host</th>
                    <th>Visitors</th>
                    <th>Visit Period</th>
                    <th>Status</th>
                    <th>Decision</th>
                    <th>Comments</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>

                            <!-- VISIT -->
                            <td>

                                <div class="report-reference">

                                    <span>
                                        VISIT REFERENCE
                                    </span>

                                    <strong>
                                        @item.VisitReference
                                    </strong>

                                    <div class="approval-report-department">

                                        <i class="bi bi-building"></i>

                                        @(string.IsNullOrWhiteSpace(
                                                                        item.DepartmentName)
                                                                        ? "-"
                                                                        : item.DepartmentName)

                            </div>

                                </div>

                            </td>


                            <!-- HOST -->
                            <td>

                                <div class="approval-report-host">

                                    <div class="approval-report-avatar">
                                        <i class="bi bi-person-badge"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.HostName
                                        </strong>

                                        <span>
                                            Host
                                        </span>
                                    </div>

                                </div>

                            </td>


                            <!-- VISITORS -->
                            <td>

                                <div class="approval-report-count">

                                    <i class="bi bi-people"></i>

                                    <strong>
                                        @item.VisitorCount
                                    </strong>

                                    <span>
                                        visitor@(item.VisitorCount == 1 ? "" : "s")
                                    </span>

                                </div>

                            </td>


                            <!-- PERIOD -->
                            <td>

                                <div class="approval-report-period">

                                    <div>

                                        <span class="period-dot period-start"></span>

                                        <div>
                                            <strong>
                                                @item.VisitFromDateTime.ToString("dd MMM yyyy")
                                            </strong>

                                            <span>
                                                @item.VisitFromDateTime.ToString("hh:mm tt")
                                            </span>
                                        </div>

                                    </div>


                                    <div>

                                        <span class="period-dot period-end"></span>

                                        <div>
                                            <strong>
                                                @item.VisitToDateTime.ToString("dd MMM yyyy")
                                            </strong>

                                            <span>
                                                @item.VisitToDateTime.ToString("hh:mm tt")
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                        @switch (item.Status)
                                {
                                    case "PendingApproval":

                                        <span class="approval-report-status status-pending">

                                            <i class="bi bi-hourglass-split"></i>

                                            Pending

                                        </span>

                                        break;


                                    case "Approved":

                                        <span class="approval-report-status status-approved">

                                            <i class="bi bi-check-circle"></i>

                                            Approved

                                        </span>

                                        break;


                                    case "ReadyForVisit":

                                        <span class="approval-report-status status-approved">

                                            <i class="bi bi-check-circle"></i>

                                            Ready

                                        </span>

                                        break;


                                    case "Rejected":

                                        <span class="approval-report-status status-rejected">

                                            <i class="bi bi-x-circle"></i>

                                            Rejected

                                        </span>

                                        break;


                                    default:

                                        <span class="approval-report-status status-neutral">

                                            @item.Status

                                        </span>

                                        break;
                                }

                            </td>


                            <!-- DECISION -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.DecisionBy))
                                {
                                    <div class="approval-report-decision">

                                        <div class="approval-decision-user">

                                            <i class="bi bi-person-check"></i>

                                            <strong>
                                                @item.DecisionBy
                                            </strong>

                                        </div>


                                        @if (item.DecisionDate.HasValue)
                                        {
                                            <span>

                                                <i class="bi bi-clock"></i>

                                                @item.DecisionDate.Value.ToString("dd MMM yyyy, hh:mm tt")

                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="approval-awaiting">

                                        <i class="bi bi-clock-history"></i>

                                        Awaiting decision

                                    </span>
                                }

                            </td>


                            <!-- COMMENTS -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                                        item.DecisionComments))
                                {
                                    <div class="approval-report-comments"
                                         title="@item.DecisionComments">

                                        <i class="bi bi-chat-left-text"></i>

                                        <span>
                                            @item.DecisionComments
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-shield-check"></i>

                                <strong>
                                    No approval records found
                                </strong>

                                <span>
                                    Try adjusting the report filters.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>