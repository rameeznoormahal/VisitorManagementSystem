@model VMS.Web.ViewModels.Reports.CurrentlyInsideReportViewModel

@using VMS.Domain.Entities

@{
    ViewData["Title"] = "Currently Inside";

    var departments =
        ViewBag.Departments as IEnumerable<Department>;
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Currently Inside</h2>

        <p>
            Live view of visitors currently checked in to the facility.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>


<!-- LIVE STATUS -->
<div class="live-report-banner mb-3">

    <div class="live-report-left">

        <div class="live-report-icon">
            <i class="bi bi-building-check"></i>
        </div>

        <div>
            <span>LIVE FACILITY STATUS</span>

            <strong>
                @Model.Items.Count visitor(s) currently inside
            </strong>
        </div>

    </div>

    <div class="live-indicator">
        <span></span>
        LIVE
    </div>

</div>


<!-- FILTERS -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="CurrentlyInside"
          class="currently-inside-filter-form">

        <div class="premium-search-box currently-inside-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Search visitor, ID, company or visit reference..." />

        </div>


        <div class="premium-filter-select">

            <label class="report-filter-label">
                Department
            </label>

            <select name="departmentId"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Departments
                </option>

                @if (departments != null)
                {
                    foreach (var department in departments)
                    {
                        <option value="@department.DepartmentId"
                                selected="@(Model.DepartmentId == department.DepartmentId)">
                            @department.DepartmentName
                        </option>
                    }
                }

            </select>

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-funnel"></i>
            Apply

        </button>


        <a asp-action="CurrentlyInside"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-counterclockwise"></i>
            Reset

        </a>

    </form>

</div>


<!-- KPI -->
<div class="row g-3 mb-3">

    <div class="col-md-4 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-building-check"></i>
            </div>

            <div>
                <span>Currently Inside</span>

                <strong>
                    @Model.Items.Count
                </strong>
            </div>

        </div>

    </div>

</div>


<!-- TABLE -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Visitors Currently Inside</h5>

            <span>
                @Model.Items.Count visitor(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-people"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table currently-inside-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visitor</th>
                    <th>Identity</th>
                    <th>Company</th>
                    <th>Visit</th>
                    <th>Department</th>
                    <th>Check-In</th>
                    <th>Time Inside</th>
                    <th>Status</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="currently-inside-row">

                            <!-- VISITOR -->
                            <td>

                                <a asp-controller="Visitor"
                                   asp-action="Details"
                                   asp-route-id="@item.VisitorId"
                                   class="report-visitor-profile">

                                    <div class="report-visitor-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.VisitorName
                                        </strong>

                                        <span>
                                            Currently on site
                                        </span>
                                    </div>

                                </a>

                            </td>


                            <!-- ID -->
                            <td>

                                <div class="report-id">

                                    <i class="bi bi-person-vcard"></i>

                                    <span>
                                        @item.IdNumber
                                    </span>

                                </div>

                            </td>


                            <!-- COMPANY -->
                            <td>

                                <div class="currently-inside-company">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(item.CompanyName)
                                                                        ? "-"
                                                                        : item.CompanyName)
                                                                                       </span>

                                </div>

                            </td>


                            <!-- VISIT -->
                            <td>

                                <div class="report-reference">

                                    <span>
                                        VISIT REFERENCE
                                    </span>

                                    <strong>
                                        @item.VisitReference
                                    </strong>

                                </div>

                            </td>


                            <!-- DEPARTMENT -->
                            <td>

                                <div class="report-department">

                                    <i class="bi bi-diagram-3"></i>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(item.DepartmentName)
                                                                        ? "-"
                                                                        : item.DepartmentName)
                            </span>

                                </div>

                            </td>


                            <!-- CHECK IN -->
                            <td>

                                <div class="report-time">

                                    <span class="report-time-icon report-entry">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                    </span>

                                    <div>

                                        <strong>
                                            @item.EntryTime.ToString("hh:mm tt")
                                        </strong>

                                        <span>
                                            @item.EntryTime.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- DURATION -->
                            <td>

                                <span class="currently-inside-duration">

                                    <i class="bi bi-stopwatch"></i>

                            @if (item.DurationInside.TotalDays >= 1)
                                    {
                                        <text>
                                            @((int)item.DurationInside.TotalDays)d
                                            @item.DurationInside.Hours.ToString("00")h
                                            @item.DurationInside.Minutes.ToString("00")m
                                        </text>
                                    }
                                    else
                                    {
                                        <text>
                                            @((int)item.DurationInside.TotalHours)h
                                            @item.DurationInside.Minutes.ToString("00")m
                                        </text>
                                    }

                                </span>

                            </td>


                            <!-- STATUS -->
                            <td>

                                <span class="reception-status status-inside">

                                    <i class="bi bi-circle-fill"></i>
                                    Inside

                                </span>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-building-check"></i>

                                <strong>
                                    No visitors currently inside
                                </strong>

                                <span>
                                    The facility currently has no checked-in visitors.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>