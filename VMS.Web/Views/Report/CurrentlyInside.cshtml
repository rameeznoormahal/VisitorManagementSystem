@model VMS.Web.ViewModels.Reports.CurrentlyInsideReportViewModel

@using VMS.Domain.Entities

@{
    ViewData["Title"] = "Currently Inside";

    var departments =
        ViewBag.Departments as IEnumerable<Department>;
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2 class="mb-1">Currently Inside</h2>

        <div class="text-muted">
            Live list of visitors currently checked in
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Reports

    </a>

</div>


<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Filters</strong>
    </div>

    <div class="card-body">

        <form method="get"
              asp-action="CurrentlyInside">

            <div class="row g-3">

                <div class="col-md-6">

                    <label class="form-label">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Visitor, ID, company or visit reference..." />

                </div>


                <div class="col-md-4">

                    <label class="form-label">
                        Department
                    </label>

                    <select name="departmentId"
                            class="form-select">

                        <option value="">
                            All Departments
                        </option>

                        @if (departments != null)
                        {
                            foreach (var department in departments)
                            {
                                <option value="@department.DepartmentId"
                                        selected="@(Model.DepartmentId == department.DepartmentId)">
                                    @department.DepartmentName
                                </option>
                            }
                        }

                    </select>

                </div>

            </div>


            <div class="d-flex gap-2 mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>
                    Apply Filters

                </button>

                <a asp-action="CurrentlyInside"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset

                </a>

            </div>

        </form>

    </div>
</div>


<div class="row g-3 mb-4">

    <div class="col-md-4">

        <div class="card dashboard-card h-100">

            <div class="card-body">

                <div class="kpi-header">

                    <div>

                        <div class="dashboard-label">
                            Currently Inside
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count
                        </div>

                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-building-check"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Visitors Currently Inside</strong>

        <span class="text-muted small">
            @Model.Items.Count visitor(s)
        </span>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Visitor</th>
                        <th>ID Number</th>
                        <th>Company</th>
                        <th>Visit Reference</th>
                        <th>Department</th>
                        <th>Check-In</th>
                        <th>Time Inside</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <a asp-controller="Visitor"
                                       asp-action="Details"
                                       asp-route-id="@item.VisitorId"
                                       class="text-decoration-none">

                                        <strong>
                                            @item.VisitorName
                                        </strong>

                                    </a>
                                </td>

                                <td>
                                    @item.IdNumber
                                </td>

                                <td>
                                    @item.CompanyName
                                </td>

                                <td>
                                    @item.VisitReference
                                </td>

                                <td>
                                    @item.DepartmentName
                                </td>

                                <td>
                                    @item.EntryTime.ToString(
                                    "dd-MMM-yyyy hh:mm tt")
                        </td>

                        <td>

                            @if (item.DurationInside.TotalDays >= 1)
                                    {
                                        <span>
                                            @((int)item.DurationInside.TotalDays)d
                                            @item.DurationInside.Hours.ToString("00")h
                                            @item.DurationInside.Minutes.ToString("00")m
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            @((int)item.DurationInside.TotalHours)h
                                            @item.DurationInside.Minutes.ToString("00")m
                                        </span>
                                    }

                                </td>

                                <td>
                                    <span class="badge bg-success">
                                        Inside
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center text-muted py-4">

                                <i class="bi bi-building-check fs-4 d-block mb-2"></i>

                                No visitors are currently inside.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>