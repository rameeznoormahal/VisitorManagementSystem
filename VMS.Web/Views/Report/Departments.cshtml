@model VMS.Web.ViewModels.Reports.DepartmentSummaryViewModel

@{
    ViewData["Title"] = "Department Summary";

    var maxVisits = Model.Items.Any()
        ? Model.Items.Max(x => x.TotalVisits)
        : 0;
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Department Summary</h2>

        <p>
            Compare visit and visitor activity across departments.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>


<!-- FILTERS -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="Departments"
          class="department-report-filter-form">

        <div class="access-filter-field">

            <label>
                From Date
            </label>

            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <div class="access-filter-field">

            <label>
                To Date
            </label>

            <input type="date"
                   name="toDate"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-funnel"></i>
            Apply

        </button>


        <a asp-action="Departments"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-counterclockwise"></i>
            Reset

        </a>

    </form>

</div>


<!-- KPI -->
<div class="row g-3 mb-3">

    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-blue">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <span>Departments</span>

                <strong>
                    @Model.Items.Count
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-calendar2-check"></i>
            </div>

            <div>
                <span>Total Visits</span>

                <strong>
                    @Model.Items.Sum(x => x.TotalVisits)
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Total Visitors</span>

                <strong>
                    @Model.Items.Sum(x => x.TotalVisitors)
                </strong>
            </div>

        </div>

    </div>

</div>


<!-- RESULTS -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Department Activity</h5>

            <span>
                @Model.Items.Count department(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-building"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table department-summary-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Department</th>
                    <th>Activity</th>
                    <th>Total Visitors</th>
                    <th>Pending</th>
                    <th>Approved / Ready</th>
                    <th>Rejected</th>
                    <th>Completed</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var activityPercent =
                        maxVisits > 0
                        ? (item.TotalVisits * 100.0 / maxVisits)
                        : 0;

                        <tr>

                            <!-- DEPARTMENT -->
                            <td>

                                <div class="department-report-profile">

                                    <div class="department-report-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.DepartmentName
                                        </strong>

                                        <span>
                                            Department
                                        </span>
                                    </div>

                                </div>

                            </td>


                            <!-- ACTIVITY -->
                            <td>

                                <div class="department-activity">

                                    <div class="department-activity-top">

                                        <strong>
                                            @item.TotalVisits
                                        </strong>

                                        <span>
                                            visit@(item.TotalVisits == 1 ? "" : "s")
                                        </span>

                                    </div>


                                    <div class="department-activity-track">

                                        <div class="department-activity-fill"
                                             style="width:@activityPercent.ToString("0")%">
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- VISITORS -->
                            <td>

                                <div class="department-visitor-count">

                                    <i class="bi bi-people"></i>

                                    <strong>
                                        @item.TotalVisitors
                                    </strong>

                                    <span>
                                        visitors
                                    </span>

                                </div>

                            </td>


                            <!-- PENDING -->
                            <td>

                                <span class="department-status-count status-pending">

                                    <i class="bi bi-hourglass-split"></i>
                                    @item.PendingVisits

                                </span>

                            </td>


                            <!-- APPROVED -->
                            <td>

                                <span class="department-status-count status-approved">

                                    <i class="bi bi-check-circle"></i>
                                    @item.ApprovedVisits

                                </span>

                            </td>


                            <!-- REJECTED -->
                            <td>

                                <span class="department-status-count status-rejected">

                                    <i class="bi bi-x-circle"></i>
                                    @item.RejectedVisits

                                </span>

                            </td>


                            <!-- COMPLETED -->
                            <td>

                                <span class="department-status-count status-completed">

                                    <i class="bi bi-check2-all"></i>
                                    @item.CompletedVisits

                                </span>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-building"></i>

                                <strong>
                                    No department data found
                                </strong>

                                <span>
                                    Try changing the selected report period.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>