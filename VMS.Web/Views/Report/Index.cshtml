@{
    ViewData["Title"] = "Reports";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Reports</h2>

        <p>
            Visitor management reports, audit views and operational analysis.
        </p>
    </div>

</div>


<div class="reports-grid">

    <!-- VISIT REPORT -->
    <a asp-controller="Report"
       asp-action="Visits"
       class="premium-report-card">

        <div class="premium-report-icon stat-purple">
            <i class="bi bi-calendar2-check"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                VISITS
            </span>

            <h5>
                Visit Report
            </h5>

            <p>
                Review visit requests by date,
                department, status and schedule.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <i class="bi bi-arrow-up-right premium-report-corner"></i>

    </a>


    <!-- VISITOR REPORT -->
    <a asp-controller="Report"
       asp-action="Visitors"
       class="premium-report-card">

        <div class="premium-report-icon stat-green">
            <i class="bi bi-people"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                VISITORS
            </span>

            <h5>
                Visitor Report
            </h5>

            <p>
                Review registered visitors, companies
                and visitor activity history.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <i class="bi bi-arrow-up-right premium-report-corner"></i>

    </a>


    <!-- ACCESS REPORT -->
    <a asp-controller="Report"
       asp-action="Access"
       class="premium-report-card">

        <div class="premium-report-icon stat-blue">
            <i class="bi bi-clock-history"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                ACCESS
            </span>

            <h5>
                Access Report
            </h5>

            <p>
                Analyze check-in, check-out and
                visitor access duration history.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <i class="bi bi-arrow-up-right premium-report-corner"></i>

    </a>


    <!-- CURRENTLY INSIDE -->
    <a asp-controller="Report"
       asp-action="CurrentlyInside"
       class="premium-report-card">

        <div class="premium-report-icon stat-green">
            <i class="bi bi-building-check"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                LIVE STATUS
            </span>

            <h5>
                Currently Inside
            </h5>

            <p>
                View visitors currently present
                within the facility.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <span class="premium-report-live">
            <span></span>
            LIVE
        </span>

    </a>


    <!-- APPROVAL REPORT -->
    <a asp-controller="Report"
       asp-action="Approvals"
       class="premium-report-card">

        <div class="premium-report-icon stat-yellow">
            <i class="bi bi-shield-check"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                APPROVALS
            </span>

            <h5>
                Approval Report
            </h5>

            <p>
                Analyze approved, rejected and
                pending visit decisions.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <i class="bi bi-arrow-up-right premium-report-corner"></i>

    </a>


    <!-- DEPARTMENT SUMMARY -->
    <a asp-controller="Report"
       asp-action="Departments"
       class="premium-report-card">

        <div class="premium-report-icon stat-coral">
            <i class="bi bi-building"></i>
        </div>

        <div class="premium-report-content">

            <span class="premium-report-category">
                ORGANIZATION
            </span>

            <h5>
                Department Summary
            </h5>

            <p>
                Compare visitor and visit activity
                across departments.
            </p>

            <div class="premium-report-action">
                Open Report
                <i class="bi bi-arrow-right"></i>
            </div>

        </div>

        <i class="bi bi-arrow-up-right premium-report-corner"></i>

    </a>

</div>