@model VMS.Web.ViewModels.Reports.VisitorReportViewModel

@{
    ViewData["Title"] = "Visitor Report";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Visitor Report</h2>
        <div class="text-muted">
            Visitor activity and master-data summary
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Reports
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header">
        <strong>Report Filters</strong>
    </div>

    <div class="card-body">
        <form method="get"
              asp-action="Visitors">

            <div class="row g-3">

                <div class="col-lg-4 col-md-6">
                    <label class="form-label">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Name, ID, company or mobile..." />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">All Visitors</option>

                        <option value="active"
                                selected="@(Model.Status == "active")">
                            Active
                        </option>

                        <option value="inactive"
                                selected="@(Model.Status == "inactive")">
                            Inactive
                        </option>

                        <option value="expired"
                                selected="@(Model.Status == "expired")">
                            Expired ID
                        </option>

                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">
                        From Date
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label">
                        To Date
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

            </div>

            <div class="d-flex gap-2 mt-3">

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-search me-1"></i>
                    Apply Filters
                </button>

                <a asp-action="Visitors"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset
                </a>

            </div>

        </form>
    </div>
</div>


<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Visitors
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count
                        </div>
                    </div>

                    <div class="kpi-icon kpi-blue">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Total Visits
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Sum(x => x.TotalVisits)
                        </div>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Expired IDs
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                            x.IdExpiryDate < today)
                        </div>
                    </div>

                    <div class="kpi-icon kpi-red">
                        <i class="bi bi-person-x"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>


<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Visitor Results</strong>

        <span class="text-muted small">
            @Model.Items.Count record(s)
        </span>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Visitor</th>
                        <th>ID Type</th>
                        <th>ID Number</th>
                        <th>ID Expiry</th>
                        <th>Nationality</th>
                        <th>Company</th>
                        <th>Mobile</th>
                        <th>Total Visits</th>
                        <th>Last Visit</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            var expired =
                            item.IdExpiryDate < today;

                            <tr>

                                <td>
                                    <a asp-controller="Visitor"
                                       asp-action="Details"
                                       asp-route-id="@item.VisitorId"
                                       class="text-decoration-none">

                                        <strong>
                                            @item.FullName
                                        </strong>

                                    </a>
                                </td>

                                <td>@item.IdType</td>

                                <td>@item.IdNumber</td>

                                <td>
                                    @(item.IdExpiryDate.ToString(
                                                                "dd-MMM-yyyy"))
                                                                           </td>

                                <td>@item.Nationality</td>

                                <td>@item.CompanyName</td>

                                <td>@item.PhoneNumber</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.TotalVisits
                                    </span>
                                </td>

                                <td>
                                    @(item.LastVisitDate?.ToString(
                                                                "dd-MMM-yyyy hh:mm tt") ?? "-")
                        </td>

                                <td>

                            @if (expired)
                                    {
                                        <span class="badge bg-danger">
                                            ID Expired
                                        </span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>
                                No visitor records found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>