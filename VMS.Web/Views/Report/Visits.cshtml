@model VMS.Web.ViewModels.Reports.VisitReportViewModel

@using VMS.Domain.Enums
@using VMS.Domain.Entities

@{
    ViewData["Title"] = "Visit Report";

    var departments =
        ViewBag.Departments as IEnumerable<Department>;
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h2 class="mb-1">Visit Report</h2>

        <div class="text-muted">
            Search and review visit requests
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Reports
    </a>

</div>


<!-- FILTERS -->
<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Report Filters</strong>
    </div>

    <div class="card-body">

        <form method="get"
              asp-action="Visits">

            <div class="row g-3">

                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        From Date
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        To Date
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        Department
                    </label>

                    <select name="departmentId"
                            class="form-select">

                        <option value="">
                            All Departments
                        </option>

                        @if (departments != null)
                        {
                            foreach (var department in departments)
                            {
                                <option value="@department.DepartmentId"
                                        selected="@(Model.DepartmentId == department.DepartmentId)">
                                    @department.DepartmentName
                                </option>
                            }
                        }

                    </select>
                </div>


                <div class="col-lg-2 col-md-4">
                    <label class="form-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        @foreach (var status in Enum.GetValues<VisitStatus>())
                        {
                            <option value="@status"
                                    selected="@(Model.Status == status.ToString())">
                                @status
                            </option>
                        }

                    </select>
                </div>


                <div class="col-lg-4 col-md-8">
                    <label class="form-label">
                        Search
                    </label>

                    <input type="text"
                           name="search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Reference or purpose..." />
                </div>

            </div>


            <div class="d-flex gap-2 mt-3">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>
                    Apply Filters

                </button>

                <a asp-action="Visits"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset

                </a>

            </div>

        </form>

    </div>
</div>


<!-- KPI SUMMARY -->
<div class="row g-3 mb-4">

    <div class="col-md-3">

        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Total Visits
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count
                        </div>
                    </div>

                    <div class="kpi-icon kpi-blue">
                        <i class="bi bi-calendar2-check"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Total Visitors
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Sum(x => x.VisitorCount)
                        </div>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Approved / Ready
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                            x.Status == VisitStatus.Approved.ToString() ||
                            x.Status == VisitStatus.ReadyForVisit.ToString())
                        </div>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-check-circle"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>


    <div class="col-md-3">

        <div class="card dashboard-card h-100">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Rejected
                        </div>

                        <div class="dashboard-value">
                            @Model.Items.Count(x =>
                                                        x.Status == VisitStatus.Rejected.ToString())
                        </div>
                    </div>

                    <div class="kpi-icon kpi-red">
                        <i class="bi bi-x-circle"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>


<!-- REPORT RESULTS -->
<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <strong>Visit Results</strong>

        <span class="text-muted small">
            @Model.Items.Count record(s)
        </span>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Host</th>
                        <th>Department</th>
                        <th>Purpose</th>
                        <th>Visitors</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.VisitReference
                                    </strong>
                                </td>

                                <td>
                                    @item.VisitFromDateTime.ToString(
                                    "dd-MMM-yyyy hh:mm tt")
                        </td>

                        <td>
                            @item.VisitToDateTime.ToString(
                                                        "dd-MMM-yyyy hh:mm tt")
                        </td>

                        <td>
                            @item.HostName
                        </td>

                        <td>
                            @item.DepartmentName
                        </td>

                        <td>
                            @item.Purpose
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @item.VisitorCount
                            </span>
                        </td>

                        <td>
                            @switch (item.Status)
                                    {
                                        case "PendingApproval":
                                            <span class="badge bg-warning text-dark">
                                                Pending Approval
                                            </span>
                                            break;

                                        case "Approved":
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                            break;

                                        case "ReadyForVisit":
                                            <span class="badge bg-success">
                                                Ready For Visit
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                            break;

                                        case "CheckedIn":
                                            <span class="badge bg-primary">
                                                Checked In
                                            </span>
                                            break;

                                        case "CheckedOut":
                                            <span class="badge bg-secondary">
                                                Checked Out
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-light text-dark">
                                                @item.Status
                                            </span>
                                            break;
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center text-muted py-4">

                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>

                                No visit records found for the selected filters.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>