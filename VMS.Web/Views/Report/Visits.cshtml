@model VMS.Web.ViewModels.Reports.VisitReportViewModel

@using VMS.Domain.Enums
@using VMS.Domain.Entities

@{
    ViewData["Title"] = "Visit Report";

    var departments =
        ViewBag.Departments as IEnumerable<Department>;
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            REPORTING & ANALYTICS
        </div>

        <h2>Visit Report</h2>

        <p>
            Analyze visit requests, visitor volumes and approval activity.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Reports

    </a>

</div>


<!-- FILTERS -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="Visits"
          class="visit-report-filter-form">

        <!-- SEARCH -->
        <div class="premium-search-box visit-report-search">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Reference or purpose..." />

        </div>


        <!-- DEPARTMENT -->
        <div class="visit-filter-field">

            <label>Department</label>

            <select name="departmentId"
                    class="form-select">

                <option value="">
                    All Departments
                </option>

                @if (departments != null)
                {
                    foreach (var department in departments)
                    {
                        <option value="@department.DepartmentId"
                                selected="@(Model.DepartmentId == department.DepartmentId)">
                            @department.DepartmentName
                        </option>
                    }
                }

            </select>

        </div>


        <!-- STATUS -->
        <div class="visit-filter-field">

            <label>Status</label>

            <select name="status"
                    class="form-select">

                <option value="">
                    All Statuses
                </option>

                @foreach (var status in Enum.GetValues<VisitStatus>())
                {
                    <option value="@status"
                            selected="@(Model.Status == status.ToString())">
                        @status
                    </option>
                }

            </select>

        </div>


        <!-- FROM -->
        <div class="visit-filter-field">

            <label>From</label>

            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <!-- TO -->
        <div class="visit-filter-field">

            <label>To</label>

            <input type="date"
                   name="toDate"
                   value="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-funnel"></i>
            Apply

        </button>


        <a asp-action="Visits"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-counterclockwise"></i>
            Reset

        </a>

    </form>

</div>


<!-- KPI SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-md-6 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-blue">
                <i class="bi bi-calendar2-check"></i>
            </div>

            <div>
                <span>Total Visits</span>

                <strong>
                    @Model.Items.Count
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-6 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Total Visitors</span>

                <strong>
                    @Model.Items.Sum(x => x.VisitorCount)
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-6 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Approved / Ready</span>

                <strong>
                    @Model.Items.Count(x =>
                    x.Status == VisitStatus.Approved.ToString() ||
                    x.Status == VisitStatus.ReadyForVisit.ToString())
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-6 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-red">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>
                <span>Rejected</span>

                <strong>
                    @Model.Items.Count(x =>
                                        x.Status == VisitStatus.Rejected.ToString())
                </strong>
            </div>

        </div>

    </div>

</div>


<!-- RESULTS -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Visit Activity</h5>

            <span>
                @Model.Items.Count record(s)
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-calendar2-week"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table visit-report-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visit</th>
                    <th>Schedule</th>
                    <th>Host</th>
                    <th>Department</th>
                    <th>Purpose</th>
                    <th>Visitors</th>
                    <th>Status</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>

                            <!-- VISIT -->
                            <td>

                                <div class="visit-report-reference">

                                    <div class="visit-report-reference-icon">
                                        <i class="bi bi-calendar2-check"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @item.VisitReference
                                        </strong>

                                        <span>
                                            Visit Request
                                        </span>

                                    </div>

                                </div>

                            </td>


                            <!-- SCHEDULE -->
                            <td>

                                <div class="visit-report-schedule">

                                    <div>
                                        <i class="bi bi-box-arrow-in-right"></i>

                                        <span>From</span>

                                        <strong>
                                            @item.VisitFromDateTime.ToString(
                                            "dd MMM yyyy, hh:mm tt")
                                </strong>
                            </div>

                            <div>
                                <i class="bi bi-box-arrow-right"></i>

                                <span>To</span>

                                <strong>
                                    @item.VisitToDateTime.ToString(
                                                                        "dd MMM yyyy, hh:mm tt")
                                </strong>
                            </div>

                        </div>

                    </td>


                    <!-- HOST -->
                    <td>

                        <div class="visit-report-host">

                            <i class="bi bi-person"></i>

                            <span>
                                @item.HostName
                            </span>

                        </div>

                    </td>


                    <!-- DEPARTMENT -->
                    <td>

                        <div class="visit-report-department">

                            <i class="bi bi-building"></i>

                            <span>
                                @item.DepartmentName
                            </span>

                        </div>

                    </td>


                    <!-- PURPOSE -->
                    <td>

                        <div class="visit-report-purpose"
                             title="@item.Purpose">

                            @(string.IsNullOrWhiteSpace(item.Purpose)
                                                        ? "-"
                                                        : item.Purpose)

                        </div>

                            </td>


                            <!-- VISITORS -->
                            <td>

                                <div class="visit-report-visitors">

                                    <i class="bi bi-people"></i>

                                    <strong>
                                        @item.VisitorCount
                                    </strong>

                                    <span>
                                        visitor@(item.VisitorCount == 1 ? "" : "s")
                                    </span>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                        @switch (item.Status)
                                {
                                    case "PendingApproval":

                                        <span class="visit-report-status visit-status-pending">
                                            <i class="bi bi-hourglass-split"></i>
                                            Pending
                                        </span>

                                        break;


                                    case "Approved":

                                        <span class="visit-report-status visit-status-approved">
                                            <i class="bi bi-check-circle"></i>
                                            Approved
                                        </span>

                                        break;


                                    case "ReadyForVisit":

                                        <span class="visit-report-status visit-status-ready">
                                            <i class="bi bi-shield-check"></i>
                                            Ready
                                        </span>

                                        break;


                                    case "Rejected":

                                        <span class="visit-report-status visit-status-rejected">
                                            <i class="bi bi-x-circle"></i>
                                            Rejected
                                        </span>

                                        break;


                                    case "CheckedIn":

                                        <span class="visit-report-status visit-status-inside">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            Checked In
                                        </span>

                                        break;


                                    case "CheckedOut":

                                        <span class="visit-report-status visit-status-completed">
                                            <i class="bi bi-check2-all"></i>
                                            Checked Out
                                        </span>

                                        break;


                                    default:

                                        <span class="visit-report-status visit-status-default">
                                            @item.Status
                                        </span>

                                        break;
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <div class="reception-empty-state">

                                <i class="bi bi-calendar-x"></i>

                                <strong>
                                    No visit records found
                                </strong>

                                <span>
                                    Try changing the selected report filters.
                                </span>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>