@model VMS.Web.ViewModels.Users.UserEditViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            USER MANAGEMENT
        </div>

        <h2>Edit User</h2>

        <p>
            Update profile information, department,
            manager and access groups.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Users

    </a>

</div>


<div class="premium-form-card">

    <div class="premium-form-card-header">

        <div>
            <h5>User Information</h5>

            <span>
                Maintain the selected user's profile and access settings.
            </span>
        </div>

        <div class="premium-form-header-icon stat-purple">
            <i class="bi bi-person-gear"></i>
        </div>

    </div>


    <form asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="UserId" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger m-3">
        </div>


        <!-- BASIC INFORMATION -->
        <div class="premium-form-body">

            <div class="form-section-title">

                <i class="bi bi-person"></i>

                <div>
                    <strong>Basic Information</strong>

                    <span>
                        User identity and contact information
                    </span>
                </div>

            </div>


            <div class="row g-3">

                <div class="col-md-4">

                    <label asp-for="EmployeeCode"
                           class="premium-form-label">
                        Employee Code
                    </label>

                    <input asp-for="EmployeeCode"
                           class="form-control premium-form-control"
                           placeholder="Employee code" />

                    <span asp-validation-for="EmployeeCode"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-8">

                    <label asp-for="FullName"
                           class="premium-form-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           class="form-control premium-form-control"
                           placeholder="Full name" />

                    <span asp-validation-for="FullName"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Email"
                           class="premium-form-label">
                        Email Address
                    </label>

                    <div class="premium-input-group">

                        <span class="premium-input-icon">
                            <i class="bi bi-envelope"></i>
                        </span>

                        <input asp-for="Email"
                               type="email"
                               class="form-control premium-form-control premium-form-icon-control" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="PhoneNumber"
                           class="premium-form-label">
                        Phone Number
                    </label>

                    <div class="premium-input-group">

                        <span class="premium-input-icon">
                            <i class="bi bi-telephone"></i>
                        </span>

                        <input asp-for="PhoneNumber"
                               class="form-control premium-form-control premium-form-icon-control" />

                    </div>

                    <span asp-validation-for="PhoneNumber"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="JobTitle"
                           class="premium-form-label">
                        Job Title
                    </label>

                    <input asp-for="JobTitle"
                           class="form-control premium-form-control"
                           placeholder="Job title" />

                    <span asp-validation-for="JobTitle"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="DepartmentId"
                           class="premium-form-label">
                        Department
                    </label>

                    <select asp-for="DepartmentId"
                            asp-items="Model.Departments"
                            class="form-select premium-form-control">

                        <option value="">
                            -- Select Department --
                        </option>

                    </select>

                    <span asp-validation-for="DepartmentId"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="ManagerUserId"
                           class="premium-form-label">
                        Manager
                    </label>

                    <select asp-for="ManagerUserId"
                            asp-items="Model.Managers"
                            class="form-select premium-form-control">

                        <option value="">
                            -- Select Manager --
                        </option>

                    </select>

                    <span asp-validation-for="ManagerUserId"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>


        <!-- ACCESS GROUPS -->
        <div class="user-form-section">

            <div class="form-section-title">

                <i class="bi bi-shield-lock"></i>

                <div>
                    <strong>Access Groups</strong>

                    <span>
                        Update the security groups assigned to this user.
                    </span>
                </div>

            </div>


            <div class="premium-group-select">

                <select asp-for="SelectedGroupIds"
                        asp-items="Model.Groups"
                        class="form-select premium-form-control"
                        multiple
                        size="5">
                </select>

                <div class="premium-field-help">
                    Select one or more groups. Use Ctrl / Cmd for multiple selection.
                </div>

            </div>

        </div>


        <!-- ACCOUNT STATUS -->
        <div class="user-form-section">

            <div class="premium-toggle-box">

                <div>

                    <strong>
                        Account Status
                    </strong>

                    <span>
                        Inactive users cannot sign in to the system.
                    </span>

                </div>

                <div class="form-check form-switch">

                    <input asp-for="IsActive"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>

            </div>

        </div>


        <!-- FOOTER -->
        <div class="premium-form-footer">

            <a asp-action="Index"
               class="btn premium-secondary-button">

                Cancel

            </a>

            <button type="submit"
                    class="btn premium-primary-button">

                <i class="bi bi-check-lg"></i>
                Save Changes

            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}