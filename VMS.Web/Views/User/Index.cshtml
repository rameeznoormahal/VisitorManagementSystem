@model IEnumerable<VMS.Infrastructure.Identity.ApplicationUser>

@{
    ViewData["Title"] = "Users";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            USER MANAGEMENT
        </div>

        <h2>Users</h2>

        <p>
            Manage system users, departments and account access.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-left"></i>
            Administration

        </a>

        <a asp-action="Create"
           class="btn premium-primary-button">

            <i class="bi bi-person-plus"></i>
            Add User

        </a>

    </div>

</div>


<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Total Users</span>
                <strong>@ViewBag.TotalUsers</strong>
            </div>

        </div>
    </div>


    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-person-check"></i>
            </div>

            <div>
                <span>Active Users</span>
                <strong>@ViewBag.ActiveUsers</strong>
            </div>

        </div>
    </div>


    <div class="col-md-4 col-xl-3">
        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-coral">
                <i class="bi bi-person-x"></i>
            </div>

            <div>
                <span>Inactive Users</span>
                <strong>@ViewBag.InactiveUsers</strong>
            </div>

        </div>
    </div>

</div>


<!-- FILTER -->
<div class="premium-filter-card mb-3">

    <form asp-action="Index"
          method="get"
          class="department-filter-form">

        <div class="premium-search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by employee code, name or email..." />

        </div>

        <div class="premium-filter-select">

            <select name="status"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">All Status</option>

                <option value="active"
                        selected="@(ViewBag.Status == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(ViewBag.Status == "inactive")">
                    Inactive
                </option>

            </select>

        </div>

        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-search"></i>
            Search

        </button>

        <a asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-x-lg"></i>
            Clear

        </a>

    </form>

</div>


<!-- TABLE -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>User Directory</h5>

            <span>
                @Model.Count() user(s)
            </span>
        </div>

    </div>

    <div class="table-responsive">

        <table class="table premium-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Employee Code</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Job Title</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <span class="employee-code">
                                    @item.EmployeeCode
                                </span>
                            </td>

                            <td>

                                <div class="user-table-profile">

                                    <div class="user-table-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @item.FullName
                                        </strong>

                                        @if (item.Email == "admin@vms.local")
                                        {
                                            <div class="user-protected-label">
                                                Protected administrator
                                            </div>
                                        }

                                    </div>

                                </div>

                            </td>

                            <td class="text-muted">
                                @item.Email
                            </td>

                            <td>
                                @(item.Department?.DepartmentName ?? "-")
                            </td>

                            <td>
                                @(item.JobTitle ?? "-")
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="premium-status-badge status-active">
                                        <span></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="premium-status-badge status-inactive">
                                        <span></span>
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                @if (item.Email == "admin@vms.local")
                                {
                                    <span class="protected-badge me-1">
                                        <i class="bi bi-shield-lock"></i>
                                        Protected
                                    </span>

                                    <a asp-action="ResetPassword"
                                       asp-route-id="@item.Id"
                                       class="btn table-action-button table-action-warning"
                                       title="Reset Password">

                                        <i class="bi bi-key"></i>

                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn table-action-button"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (item.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn table-action-button table-action-danger"
                                                    title="Deactivate">

                                                <i class="bi bi-slash-circle"></i>

                                            </button>

                                        </form>
                                    }

                                    <a asp-action="ResetPassword"
                                       asp-route-id="@item.Id"
                                       class="btn table-action-button table-action-warning"
                                       title="Reset Password">

                                        <i class="bi bi-key"></i>

                                    </a>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-5">

                            <i class="bi bi-search fs-4 d-block mb-2"></i>
                            No users match your search.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>