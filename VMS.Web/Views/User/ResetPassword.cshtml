@model VMS.Web.ViewModels.Users.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            ACCOUNT SECURITY
        </div>

        <h2>Reset Password</h2>

        <p>
            Set a new temporary password for this user account.
        </p>
    </div>

    <a asp-action="Index"
       class="btn premium-secondary-button">

        <i class="bi bi-arrow-left"></i>
        Back to Users

    </a>

</div>


<div class="premium-security-card">

    <div class="premium-security-header">

        <div class="premium-security-icon">
            <i class="bi bi-key"></i>
        </div>

        <div>
            <h5>Password Reset</h5>

            <span>
                The new password should be communicated securely to the user.
            </span>
        </div>

    </div>


    <div class="reset-user-summary">

        <div class="reset-user-avatar">
            <i class="bi bi-person"></i>
        </div>

        <div class="reset-user-details">

            <strong>
                @Model.FullName
            </strong>

            <span>
                @Model.Email
            </span>

        </div>

        <div class="reset-security-badge">
            <i class="bi bi-shield-lock"></i>
            Account Security
        </div>

    </div>


    <form asp-action="ResetPassword"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="UserId" />

        <input type="hidden"
               asp-for="FullName" />

        <input type="hidden"
               asp-for="Email" />


        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger m-3">
        </div>


        <div class="premium-form-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="NewPassword"
                           class="premium-form-label">
                        New Temporary Password
                    </label>

                    <div class="premium-input-group">

                        <span class="premium-input-icon">
                            <i class="bi bi-lock"></i>
                        </span>

                        <input asp-for="NewPassword"
                               id="newPassword"
                               class="form-control premium-form-control premium-form-icon-control premium-password-control"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="toggleResetPassword(
                                    'newPassword',
                                    'newPasswordIcon')">

                            <i id="newPasswordIcon"
                               class="bi bi-eye">
                            </i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="ConfirmPassword"
                           class="premium-form-label">
                        Confirm Password
                    </label>

                    <div class="premium-input-group">

                        <span class="premium-input-icon">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                        <input asp-for="ConfirmPassword"
                               id="confirmPassword"
                               class="form-control premium-form-control premium-form-icon-control premium-password-control"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                onclick="toggleResetPassword(
                                    'confirmPassword',
                                    'confirmPasswordIcon')">

                            <i id="confirmPasswordIcon"
                               class="bi bi-eye">
                            </i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small">
                    </span>

                </div>

            </div>


            <div class="password-security-note">

                <i class="bi bi-info-circle"></i>

                <div>
                    <strong>Security recommendation</strong>

                    <span>
                        Use a strong temporary password and share it with the
                        user through a secure channel.
                    </span>
                </div>

            </div>

        </div>


        <div class="premium-form-footer">

            <a asp-action="Index"
               class="btn premium-secondary-button">
                Cancel
            </a>

            <button type="submit"
                    class="btn premium-warning-button">

                <i class="bi bi-key"></i>
                Reset Password

            </button>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        function toggleResetPassword(
            inputId,
            iconId) {

            const input =
                document.getElementById(inputId);

            const icon =
                document.getElementById(iconId);

            if (input.type === "password") {

                input.type = "text";

                icon.classList.remove("bi-eye");

                icon.classList.add("bi-eye-slash");
            }
            else {

                input.type = "password";

                icon.classList.remove("bi-eye-slash");

                icon.classList.add("bi-eye");
            }
        }

    </script>

}