@using VMS.Domain.Enums

@model IEnumerable<VMS.Domain.Entities.VisitRequest>

@{
    ViewData["Title"] = "Visit Requests";
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            VISITOR MANAGEMENT
        </div>

        <h2>Visit Requests</h2>

        <p>
            Review scheduled visits, approval status and visitor access.
        </p>
    </div>

    <a asp-action="Create"
       class="btn premium-primary-button">

        <i class="bi bi-plus-lg"></i>
        New Visit Request

    </a>

</div>


<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-calendar2-week"></i>
            </div>

            <div>
                <span>Total Requests</span>

                <strong>
                    @Model.Count()
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-yellow">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>
                <span>Pending Approval</span>

                <strong>
                    @Model.Count(x =>
                    x.Status == VisitStatus.PendingApproval)
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Approved / Ready</span>

                <strong>
                    @Model.Count(x =>
                                        x.Status == VisitStatus.Approved ||
                                        x.Status == VisitStatus.ReadyForVisit)
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-coral">
                <i class="bi bi-x-circle"></i>
            </div>

            <div>
                <span>Rejected</span>

                <strong>
                    @Model.Count(x =>
                                        x.Status == VisitStatus.Rejected)
                </strong>
            </div>

        </div>

    </div>

</div>
<div class="premium-filter-card mb-3">

    <form asp-action="Index"
          method="get"
          class="visit-filter-form">

        <div class="premium-search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search reference, visitor, department or purpose..." />

        </div>


        <div class="premium-filter-select">

            <select name="status"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Status
                </option>

                <option value="pending"
                        selected="@(ViewBag.Status == "pending")">
                    Pending Approval
                </option>

                <option value="approved"
                        selected="@(ViewBag.Status == "approved")">
                    Approved
                </option>

                <option value="ready"
                        selected="@(ViewBag.Status == "ready")">
                    Ready For Visit
                </option>

                <option value="rejected"
                        selected="@(ViewBag.Status == "rejected")">
                    Rejected
                </option>

            </select>

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-search"></i>
            Search

        </button>


        <a asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-x-lg"></i>
            Clear

        </a>

    </form>

</div>
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Visit Directory</h5>

            <span>
                @Model.Count() visit request(s)
            </span>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table visit-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Visitors</th>
                    <th>Schedule</th>
                    <th>Department</th>
                    <th>Purpose</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <!-- REFERENCE -->
                            <td>

                                <div class="visit-reference">

                                    <div class="visit-reference-icon">
                                        <i class="bi bi-calendar2-check"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @item.VisitReference
                                        </strong>

                                        <span>
                                            @item.CreatedDate
                                </span>

                            </div>

                        </div>

                    </td>


                    <!-- VISITORS -->
                    <td>

                        <div class="visitor-stack">

                            @foreach (var visitor in item.VisitVisitors)
                                    {
                                        <div class="visit-person">

                                            <span class="visit-person-avatar">
                                                <i class="bi bi-person"></i>
                                            </span>

                                            <span>
                                                @visitor.Visitor.FullName
                                            </span>

                                        </div>
                                    }

                                </div>

                                <span class="visitor-count-badge">
                                    @item.VisitVisitors.Count visitor(s)
                                </span>

                            </td>


                            <!-- DATE -->
                            <td>

                                <div class="visit-date">

                                    <strong>
                                        @item.VisitFromDateTime
                                    </strong>

                                    <span>
                                        @item.VisitFromDateTime
                                        -
                                        @item.VisitToDateTime
                                    </span>

                                </div>

                            </td>


                            <!-- DEPARTMENT -->
                            <td>

                                <div class="department-display">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @item.Department?.DepartmentName
                                    </span>

                                </div>

                            </td>


                            <!-- PURPOSE -->
                            <td>

                                <div class="visit-purpose">
                                    @item.Purpose
                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                                @switch (item.Status)
                                {
                                    case VisitStatus.PendingApproval:

                                        <span class="visit-status status-pending">
                                            <i class="bi bi-hourglass-split"></i>
                                            Pending Approval
                                        </span>

                                        break;


                                    case VisitStatus.Approved:

                                        <span class="visit-status status-approved">
                                            <i class="bi bi-check-circle"></i>
                                            Approved
                                        </span>

                                        break;


                                    case VisitStatus.ReadyForVisit:

                                        <span class="visit-status status-ready">
                                            <i class="bi bi-qr-code"></i>
                                            Ready For Visit
                                        </span>

                                        break;


                                    case VisitStatus.Rejected:

                                        <span class="visit-status status-rejected">
                                            <i class="bi bi-x-circle"></i>
                                            Rejected
                                        </span>

                                        break;


                                    case VisitStatus.CheckedIn:

                                        <span class="visit-status status-inside">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                            Checked In
                                        </span>

                                        break;


                                    case VisitStatus.CheckedOut:

                                        <span class="visit-status status-completed">
                                            <i class="bi bi-check2-all"></i>
                                            Completed
                                        </span>

                                        break;


                                    default:

                                        <span class="visit-status status-neutral">
                                            @item.Status
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td class="text-end">

                                <div class="visit-actions">

                                    @if (item.Status == VisitStatus.Approved)
                                    {
                                        <form asp-controller="Visit"
                                              asp-action="GenerateQr"
                                              asp-route-id="@item.VisitRequestId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn visit-action-primary"
                                                    title="Generate QR">

                                                <i class="bi bi-qr-code"></i>
                                                Generate QR

                                            </button>

                                        </form>
                                    }

                                    @if (item.Status == VisitStatus.ReadyForVisit)
                                    {
                                        <a asp-controller="Visit"
                                           asp-action="QrPreview"
                                           asp-route-id="@item.VisitRequestId"
                                           class="btn table-action-button"
                                           title="View QR">

                                            <i class="bi bi-qr-code"></i>

                                        </a>
                                        <a asp-controller="Permit"
                                           asp-action="Preview"
                                           asp-route-id="@item.VisitRequestId"
                                           class="btn table-action-button table-action-success"
                                           title="View Permit">

                                            <i class="bi bi-file-earmark-person"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center text-muted py-5">

                            <i class="bi bi-calendar-x fs-4 d-block mb-2"></i>

                            No visit requests match your search.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>