@model VMS.Domain.Entities.Visitor

@using VMS.Web.Services
@inject IPermissionService PermissionService

@{
    ViewData["Title"] = "Visitor Details";

    var canEditVisitor =
        await PermissionService.HasPermissionAsync(
            User,
            "Visitor.Edit");

    var visitHistory =
        ViewBag.VisitHistory as IEnumerable<VMS.Domain.Entities.VisitVisitor>;

    var accessHistory =
        ViewBag.AccessHistory as IEnumerable<VMS.Domain.Entities.VisitAccessLog>;

    var today = DateOnly.FromDateTime(DateTime.Today);
    var expired = Model.IdExpiryDate < today;
}



<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            VISITOR MANAGEMENT
        </div>

        <h2>Visitor Profile</h2>

        <p>
            Identity information, visit activity and access history.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-arrow-left"></i>
            Back to Visitors

        </a>

        @if (canEditVisitor)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.VisitorId"
               class="btn premium-primary-button">

                <i class="bi bi-pencil-square"></i>
                Edit Visitor

            </a>
        }

    </div>

</div>


<div class="visitor-profile-banner mb-3">

    <div class="visitor-profile-main">

        <div class="visitor-profile-avatar">
            <i class="bi bi-person"></i>
        </div>

        <div>

            <span class="visitor-profile-label">
                REGISTERED VISITOR
            </span>

            <h3>
                @Model.FullName
            </h3>

            <div class="visitor-profile-meta">

                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <span>
                        <i class="bi bi-building"></i>
                        @Model.CompanyName
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Designation))
                {
                    <span>
                        <i class="bi bi-briefcase"></i>
                        @Model.Designation
                    </span>
                }

            </div>

        </div>

    </div>


    <div>

        @if (expired)
        {
            <span class="visitor-profile-status profile-expired">
                <i class="bi bi-exclamation-triangle"></i>
                ID Expired
            </span>
        }
        else if (Model.IsActive)
        {
            <span class="visitor-profile-status profile-active">
                <i class="bi bi-check-circle"></i>
                Active Visitor
            </span>
        }
        else
        {
            <span class="visitor-profile-status profile-inactive">
                <i class="bi bi-slash-circle"></i>
                Inactive
            </span>
        }

    </div>

</div>
<div class="row g-3 mb-3">

    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-calendar2-check"></i>
            </div>

            <div>
                <span>Total Visits</span>

                <strong>
                    @ViewBag.TotalVisits
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>Completed Visits</span>

                <strong>
                    @ViewBag.CompletedVisits
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-blue">
                <i class="bi bi-box-arrow-in-right"></i>
            </div>

            <div>
                <span>Total Check-Ins</span>

                <strong>
                    @ViewBag.TotalCheckIns
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon @(ViewBag.CurrentlyInside == true ? "stat-green" : "stat-yellow")">

                <i class="bi bi-building"></i>

            </div>

            <div>
                <span>Current Status</span>

                @if (ViewBag.CurrentlyInside == true)
                {
                    <strong class="inside-text">
                        Inside
                    </strong>
                }
                else
                {
                    <strong class="outside-text">
                        Outside
                    </strong>
                }

            </div>

        </div>

    </div>

</div>
<div class="premium-profile-card mb-3">

    <div class="premium-profile-header">

        <div>
            <h5>Visitor Information</h5>

            <span>
                Identity and contact information
            </span>
        </div>

        <div class="premium-form-header-icon stat-purple">
            <i class="bi bi-person-vcard"></i>
        </div>

    </div>


    <div class="visitor-information-grid">

        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-card-text"></i>
            </div>

            <div>
                <span>ID Type</span>
                <strong>@Model.IdType</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-fingerprint"></i>
            </div>

            <div>
                <span>ID Number</span>
                <strong>@Model.IdNumber</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon @(expired ? "visitor-info-danger" : "")">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <span>ID Expiry</span>

                <strong class="@(expired ? "text-danger" : "")">
                    @Model.IdExpiryDate.ToString("dd MMM yyyy")
                </strong>

                @if (expired)
                {
                    <small class="visitor-expired-text">
                        ID document has expired
                    </small>
                }

            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-globe"></i>
            </div>

            <div>
                <span>Nationality</span>
                <strong>@(Model.Nationality ?? "-")</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-building"></i>
            </div>

            <div>
                <span>Company</span>
                <strong>@(Model.CompanyName ?? "-")</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-briefcase"></i>
            </div>

            <div>
                <span>Designation</span>
                <strong>@(Model.Designation ?? "-")</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-telephone"></i>
            </div>

            <div>
                <span>Phone</span>
                <strong>@(Model.PhoneNumber ?? "-")</strong>
            </div>

        </div>


        <div class="visitor-info-item">

            <div class="visitor-info-icon">
                <i class="bi bi-envelope"></i>
            </div>

            <div>
                <span>Email</span>
                <strong>@(Model.Email ?? "-")</strong>
            </div>

        </div>

    </div>

</div>

<div class="premium-table-card mb-3">

    <div class="premium-table-header">

        <div>
            <h5>Visit History</h5>

            <span>
                Previous and scheduled visits for this visitor
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-calendar2-week"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Schedule</th>
                    <th>Department</th>
                    <th>Purpose</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @if (visitHistory != null && visitHistory.Any())
                {
                    foreach (var item in visitHistory)
                    {
                        <tr>

                            <td>
                                <span class="visitor-history-reference">
                                    @item.VisitRequest.VisitReference
                                </span>
                            </td>


                            <td>

                                <div class="visitor-history-date">

                                    <strong>
                                        @item.VisitRequest.VisitFromDateTime.ToString("dd MMM yyyy")
                                    </strong>

                                    <span>
                                        @item.VisitRequest.VisitFromDateTime.ToString("dd MMM, hh:mm tt")
                                        -
                                        @item.VisitRequest.VisitToDateTime.ToString("dd MMM, hh:mm tt")
                                    </span>

                                </div>

                            </td>


                            <td>

                                <div class="visitor-history-department">

                                    <i class="bi bi-building"></i>

                                    @item.VisitRequest.Department?.DepartmentName

                                </div>

                            </td>


                            <td>
                                @item.VisitRequest.Purpose
                            </td>


                            <td>

                                <span class="history-status-badge">
                                    @item.VisitRequest.Status
                                </span>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-4">

                            <i class="bi bi-calendar-x d-block mb-2"></i>
                            No visit history found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Access History</h5>

            <span>
                Reception check-in and check-out activity
            </span>
        </div>

        <div class="premium-table-header-icon">
            <i class="bi bi-door-open"></i>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visit Reference</th>
                    <th>Check-In</th>
                    <th>Check-Out</th>
                    <th>Duration</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @if (accessHistory != null && accessHistory.Any())
                {
                    foreach (var item in accessHistory)
                    {
                        <tr>

                            <td>
                                <span class="visitor-history-reference">
                                    @item.VisitRequest.VisitReference
                                </span>
                            </td>


                            <td>

                                <div class="access-time access-entry">

                                    <i class="bi bi-box-arrow-in-right"></i>

                                    @item.EntryTime.ToString("dd MMM, hh:mm tt")

                        </div>

                    </td>


                    <td>

                        @if (item.ExitTime.HasValue)
                                {
                                    <div class="access-time access-exit">

                                        <i class="bi bi-box-arrow-right"></i>

                                        @item.ExitTime.Value.ToString("dd MMM, hh:mm tt")

                        </div>
                                                }
                                else
                                {
                                    <span class="text-muted">
                                        -
                                    </span>
                                }

                            </td>


                            <td>

                                @if (item.ExitTime.HasValue)
                                {
                                    var duration =
                                    item.ExitTime.Value -
                                    item.EntryTime;

                                    if (duration.TotalDays >= 1)
                                    {
                                        <span class="duration-badge">

                                            @((int)duration.TotalDays)d
                                            @duration.Hours.ToString("00")h
                                            @duration.Minutes.ToString("00")m

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="duration-badge">

                                            @((int)duration.TotalHours)h
                                            @duration.Minutes.ToString("00")m

                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="duration-ongoing">
                                        Ongoing
                                    </span>
                                }

                            </td>


                            <td>

                                @if (item.ExitTime == null)
                                {
                                    <span class="access-status access-inside">

                                        <i class="bi bi-circle-fill"></i>
                                        Currently Inside

                                    </span>
                                }
                                else
                                {
                                    <span class="access-status access-completed">

                                        <i class="bi bi-check-circle"></i>
                                        Completed

                                    </span>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center text-muted py-4">

                            <i class="bi bi-door-closed d-block mb-2"></i>
                            No access history found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>