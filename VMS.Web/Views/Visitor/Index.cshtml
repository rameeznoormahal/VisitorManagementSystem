@model IEnumerable<VMS.Domain.Entities.Visitor>

@{
    ViewData["Title"] = "Visitor Master";

    var search = ViewBag.Search as string;
    var filter = ViewBag.Filter as string;

    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="mb-1">Visitor Master</h2>
        <div class="text-muted">
            Search and maintain registered visitor records
        </div>
    </div>

    <a asp-controller="Visitor"
       asp-action="Create"
       class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>
        Add Visitor
    </a>
</div>  


<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Total Visitors
                        </div>

                        <div class="dashboard-value">
                            @ViewBag.TotalVisitors
                        </div>
                    </div>

                    <div class="kpi-icon kpi-blue">
                        <i class="bi bi-people"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Active Visitors
                        </div>

                        <div class="dashboard-value">
                            @ViewBag.ActiveVisitors
                        </div>
                    </div>

                    <div class="kpi-icon kpi-green">
                        <i class="bi bi-person-check"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="card dashboard-card">
            <div class="card-body">

                <div class="kpi-header">

                    <div>
                        <div class="dashboard-label">
                            Expired IDs
                        </div>

                        <div class="dashboard-value">
                            @ViewBag.ExpiredVisitors
                        </div>
                    </div>

                    <div class="kpi-icon kpi-red">
                        <i class="bi bi-person-x"></i>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>


<div class="card shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="row g-2 mb-4">

            <div class="col-lg-5 col-md-6">

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Search by ID, name, company, mobile or email..." />

                </div>

            </div>


            <div class="col-md-3">

                <select name="filter"
                        class="form-select">

                    <option value="">
                        All Visitors
                    </option>

                    <option value="active"
                            selected="@(filter == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(filter == "inactive")">
                        Inactive
                    </option>

                    <option value="expired"
                            selected="@(filter == "expired")">
                        Expired ID
                    </option>

                </select>

            </div>


            <div class="col-auto">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-search me-1"></i>
                    Search

                </button>

            </div>


            <div class="col-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    Clear

                </a>

            </div>

        </form>


        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID Type</th>
                        <th>ID Number</th>
                        <th>ID Expiry</th>
                        <th>Nationality</th>
                        <th>Company</th>
                        <th>Designation</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visitor in Model)
                    {
                        var expired =
                        visitor.IdExpiryDate < today;

                        <tr>

                            <td>
                                <strong>
                                    @visitor.FullName
                                </strong>
                            </td>

                            <td>
                                @visitor.IdType
                            </td>

                            <td>
                                @visitor.IdNumber
                            </td>

                            <td>
                                @(visitor.IdExpiryDate.ToString(
                                                            "dd-MMM-yyyy"))
                        </td>

                            <td>
                                @visitor.Nationality
                            </td>

                            <td>
                                @visitor.CompanyName
                            </td>

                            <td>
                                @visitor.Designation
                            </td>

                            <td>
                                @visitor.PhoneNumber
                            </td>

                            <td>

                            @if (expired)
                                {
                                    <span class="badge bg-danger">
                                        ID Expired
                                    </span>
                                }
                                else if (visitor.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@visitor.VisitorId"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye me-1"></i>
                                    View

                                </a>

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">

                                No visitors found.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>