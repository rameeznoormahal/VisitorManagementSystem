@model IEnumerable<VMS.Domain.Entities.Visitor>

@{
    ViewData["Title"] = "Visitors";

    var filter = ViewBag.Filter as string;
    var search = ViewBag.Search as string;

    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="mb-1">Visitor Master</h2>
        <div class="text-muted">
            Registered visitor information and identification status
        </div>
    </div>

</div>

<div class="card shadow-sm">

    <div class="card-body">

        <form method="get"
              asp-action="Index"
              class="row g-2 mb-4">

            <input type="hidden"
                   name="filter"
                   value="@filter" />

            <div class="col-md-5">

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="Search name, ID, company or mobile..." />

            </div>

            <div class="col-auto">

                <button type="submit"
                        class="btn btn-primary">
                    Search
                </button>

            </div>

            <div class="col-auto">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>

            </div>

        </form>

        <div class="d-flex gap-2 mb-3">

            <a asp-action="Index"
               class="btn btn-sm @(string.IsNullOrWhiteSpace(filter) ? "btn-primary" : "btn-outline-primary")">
                All
            </a>

            <a asp-action="Index"
               asp-route-filter="active"
               class="btn btn-sm @(filter == "active" ? "btn-success" : "btn-outline-success")">
                Active
            </a>

            <a asp-action="Index"
               asp-route-filter="expired"
               class="btn btn-sm @(filter == "expired" ? "btn-danger" : "btn-outline-danger")">
                Expired ID
            </a>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>ID Type</th>
                        <th>ID Number</th>
                        <th>ID Expiry</th>
                        <th>Nationality</th>
                        <th>Company</th>
                        <th>Designation</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var visitor in Model)
                    {
                        var expired =
                        visitor.IdExpiryDate < today;

                        <tr>

                            <td>
                                <strong>
                                    @visitor.FullName
                                </strong>
                            </td>

                            <td>
                                @visitor.IdType
                            </td>

                            <td>
                                @visitor.IdNumber
                            </td>

                            <td>
                                @visitor.IdExpiryDate.ToString(
                                "dd-MMM-yyyy")
                        </td>

                        <td>
                            @visitor.Nationality
                        </td>

                        <td>
                            @visitor.CompanyName
                        </td>

                        <td>
                            @visitor.Designation
                        </td>

                        <td>
                            @visitor.PhoneNumber
                        </td>

                        <td>

                            @if (expired)
                                {
                                    <span class="badge bg-danger">
                                        ID Expired
                                    </span>
                                }
                                else if (visitor.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@visitor.VisitorId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>
                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                No visitors found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>