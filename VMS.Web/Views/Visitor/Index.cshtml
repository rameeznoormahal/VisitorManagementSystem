@model IEnumerable<VMS.Domain.Entities.Visitor>

@{
    ViewData["Title"] = "Visitor Master";

    var search = ViewBag.Search as string;
    var filter = ViewBag.Filter as string;

    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="management-page-header mb-4">

    <div>
        <div class="admin-eyebrow">
            VISITOR MANAGEMENT
        </div>

        <h2>Visitor Master</h2>

        <p>
            Search, review and maintain registered visitor records.
        </p>
    </div>

    <a asp-controller="Visitor"
       asp-action="Create"
       class="btn premium-primary-button">

        <i class="bi bi-person-plus"></i>
        Add Visitor

    </a>

</div>


<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-md-4 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-purple">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <span>Total Visitors</span>

                <strong>
                    @ViewBag.TotalVisitors
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-green">
                <i class="bi bi-person-check"></i>
            </div>

            <div>
                <span>Active Visitors</span>

                <strong>
                    @ViewBag.ActiveVisitors
                </strong>
            </div>

        </div>

    </div>


    <div class="col-md-4 col-xl-3">

        <div class="mini-summary-card">

            <div class="mini-summary-icon stat-coral">
                <i class="bi bi-person-x"></i>
            </div>

            <div>
                <span>Expired IDs</span>

                <strong>
                    @ViewBag.ExpiredVisitors
                </strong>
            </div>

        </div>

    </div>

</div>


<!-- FILTER -->
<div class="premium-filter-card mb-3">

    <form method="get"
          asp-action="Index"
          class="visitor-filter-form">

        <div class="premium-search-box">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   placeholder="Search by ID, name, company, mobile or email..." />

        </div>


        <div class="premium-filter-select">

            <select name="filter"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">
                    All Visitors
                </option>

                <option value="active"
                        selected="@(filter == "active")">
                    Active
                </option>

                <option value="inactive"
                        selected="@(filter == "inactive")">
                    Inactive
                </option>

                <option value="expired"
                        selected="@(filter == "expired")">
                    Expired ID
                </option>

            </select>

        </div>


        <button type="submit"
                class="btn premium-primary-button">

            <i class="bi bi-search"></i>
            Search

        </button>


        <a asp-action="Index"
           class="btn premium-secondary-button">

            <i class="bi bi-x-lg"></i>
            Clear

        </a>

    </form>

</div>


<!-- TABLE -->
<div class="premium-table-card">

    <div class="premium-table-header">

        <div>
            <h5>Visitor Directory</h5>

            <span>
                @Model.Count() visitor(s)
            </span>
        </div>

    </div>


    <div class="table-responsive">

        <table class="table premium-table visitor-master-table align-middle mb-0">

            <thead>
                <tr>
                    <th>Visitor</th>
                    <th>ID</th>
                    <th>Expiry</th>
                    <th>Nationality</th>
                    <th>Company</th>
                    <th>Designation</th>
                    <th>Mobile</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var visitor in Model)
                    {
                        var expired =
                        visitor.IdExpiryDate < today;

                        <tr>

                            <!-- VISITOR -->
                            <td>

                                <div class="visitor-table-profile">

                                    <div class="visitor-table-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @visitor.FullName
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(visitor.Email))
                                        {
                                            <span>
                                                @visitor.Email
                                            </span>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- ID -->
                            <td>

                                <div class="visitor-id-display">

                                    <span class="visitor-id-type">
                                        @visitor.IdType
                                    </span>

                                    <strong>
                                        @visitor.IdNumber
                                    </strong>

                                </div>

                            </td>


                            <!-- EXPIRY -->
                            <td>

                                <div class="visitor-expiry-display @(expired ? "expired-date" : "")">

                                    <i class="bi bi-calendar3"></i>

                                    <span>
                                        @visitor.IdExpiryDate.ToString("dd MMM yyyy")
                                    </span>

                                </div>

                            </td>


                            <!-- NATIONALITY -->
                            <td>
                                @(visitor.Nationality ?? "-")
                            </td>


                            <!-- COMPANY -->
                            <td>

                                <div class="visitor-company-display">

                                    <i class="bi bi-building"></i>

                                    <span>
                                        @(visitor.CompanyName ?? "-")
                                    </span>

                                </div>

                            </td>


                            <!-- DESIGNATION -->
                            <td>
                                @(visitor.Designation ?? "-")
                            </td>


                            <!-- MOBILE -->
                            <td>

                                <div class="visitor-phone-display">

                                    <i class="bi bi-telephone"></i>

                                    <span>
                                        @visitor.PhoneNumber
                                    </span>

                                </div>

                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (expired)
                                {
                                    <span class="visitor-master-status status-expired-id">

                                        <i class="bi bi-exclamation-triangle"></i>
                                        ID Expired

                                    </span>
                                }
                                else if (visitor.IsActive)
                                {
                                    <span class="visitor-master-status status-active-visitor">

                                        <i class="bi bi-check-circle"></i>
                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="visitor-master-status status-inactive-visitor">

                                        <i class="bi bi-slash-circle"></i>
                                        Inactive

                                    </span>
                                }

                            </td>


                            <!-- ACTION -->
                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@visitor.VisitorId"
                                   class="btn table-action-button"
                                   title="View Visitor">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="9"
                            class="text-center text-muted py-5">

                            <i class="bi bi-search fs-4 d-block mb-2"></i>

                            No visitors match your search.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>